---
/**
 * Sektions-Container mit Farbflächen-Varianten.
 * `paper` = weiß, `surface` = helles Blaugrau, `tint` = helles Blaugrau
 * mit blauem Punktraster (Signatur-Textur), `accent` = sehr helles Blau.
 */
interface Props {
  variant?: 'paper' | 'surface' | 'tint' | 'accent';
  size?: 'md' | 'sm';
  id?: string;
  class?: string;
}

const { variant = 'paper', size = 'md', id, class: className } = Astro.props;
---

<section {id} class:list={['section', `section--${variant}`, `section--${size}`, className]}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
  }

  .section--sm {
    padding-block: var(--space-section-sm);
  }

  .section--surface {
    background: var(--color-surface);
  }

  .section--tint {
    background: var(--color-surface);
    background-image: radial-gradient(rgba(6, 89, 169, 0.09) 1px, transparent 1px);
    background-size: 26px 26px;
    border-block: 1px solid var(--color-line);
  }

  .section--accent {
    background: color-mix(in srgb, var(--color-heading) 18%, #fff);
    color: var(--color-navy);
  }
</style>
