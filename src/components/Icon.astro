---
/**
 * Inline-SVG-Icons im Brand-Stil (Stroke, rund, 24×24).
 * Einheitliches Icon-Set statt Fremd-Bibliothek (bilder-strategie.md: eigenes Set).
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const icons = {
  /* Häkchen im Kreis */
  check:
    '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/>',
  /* Schild (Konformität/Sicherheit) */
  shield:
    '<path d="M12 3l7 3v5.5c0 4.2-2.9 7.4-7 9.5-4.1-2.1-7-5.3-7-9.5V6z"/><path d="M9 11.8l2.2 2.2 3.8-4"/>',
  /* Blitz (schnell) */
  bolt: '<path d="M13 3L5 13.5h5L9.5 21 18 10.5h-5z"/>',
  /* Karte (Kartenzahlung) */
  card: '<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10.5h18M7 15.5h4"/>',
  /* Geräte (Tablet + Phone) */
  devices:
    '<rect x="3" y="5" width="13" height="15" rx="2"/><rect x="14" y="9" width="7" height="11" rx="1.8"/>',
  /* Diagramm (Berichte) */
  chart:
    '<path d="M4 20h16M7 16v-4m5 4V8m5 8v-6"/>',
  /* Personen (Mitarbeiter/Kunden) */
  users:
    '<circle cx="9" cy="9" r="3.2"/><path d="M3.5 19c.7-3 2.9-4.5 5.5-4.5s4.8 1.5 5.5 4.5"/><circle cx="17" cy="10" r="2.4"/><path d="M16 14.7c2.3.2 3.9 1.5 4.5 3.8"/>',
  /* Headset (Support) */
  support:
    '<path d="M5 13v-2a7 7 0 0114 0v2"/><rect x="3.5" y="13" width="4" height="6" rx="1.6"/><rect x="16.5" y="13" width="4" height="6" rx="1.6"/><path d="M19 19v1a2.5 2.5 0 01-2.5 2.5H13"/>',
  /* Bon/Beleg */
  receipt:
    '<path d="M6.5 3.5h11V20l-2.2-1.4L13 20l-2.3-1.4L8.5 20l-2-1.4z"/><path d="M9.5 8h5M9.5 11.5h5M9.5 15h3"/>',
  /* Drucker */
  printer:
    '<path d="M7 8V4h10v4"/><rect x="4" y="8" width="16" height="8" rx="2"/><rect x="7" y="13" width="10" height="7"/>',
  /* Synchronisieren */
  sync: '<path d="M5 9a7.5 7.5 0 0113-2.2L20 9"/><path d="M20 4.5V9h-4.5"/><path d="M19 15a7.5 7.5 0 01-13 2.2L4 15"/><path d="M4 19.5V15h4.5"/>',
  /* Einstellungen/Verwaltung */
  settings:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3M5.5 5.5l2.1 2.1M16.4 16.4l2.1 2.1M18.5 5.5l-2.1 2.1M7.6 16.4l-2.1 2.1"/>',
  /* Export/Senden */
  export:
    '<path d="M12 15V4M8.5 7.5L12 4l3.5 3.5"/><path d="M5 12v6.5A1.5 1.5 0 006.5 20h11a1.5 1.5 0 001.5-1.5V12"/>',
  /* Euro */
  euro: '<path d="M17.5 7a6.5 6.5 0 100 10M4.5 10.2h8M4.5 13.8h7"/>',
  /* Funk/Wireless */
  wifi: '<path d="M4 9.5a12 12 0 0116 0M7 13a8 8 0 0110 0M10 16.4a4 4 0 014 0"/><circle cx="12" cy="19" r="1.3" fill="currentColor" stroke="none"/>',
  /* Stern */
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9z"/>',
  /* Telefon */
  phone:
    '<path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1z"/>',
  /* Pfeil rechts */
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"/>',
  /* Uhr (Zeit sparen) */
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  /* Wolke (Cloud) */
  cloud:
    '<path d="M7 18a4.5 4.5 0 01-.4-9A6 6 0 0118 8.5 4 4 0 0117.5 18z"/>',
  /* Standort */
  pin: '<path d="M12 21s-6.5-5.5-6.5-10.5a6.5 6.5 0 0113 0C18.5 15.5 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.3"/>',
} as const;

const { name, size = 26, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icons[name]}
/>
