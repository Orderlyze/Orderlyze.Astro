---
import { Image } from 'astro:assets';
import logo from '../assets/logos/orderlyze-logo.png';
import Button from './Button.astro';
import { NAV, NAV_EXTRA } from '../config/nav';
import { SITE, EVENTS } from '../config/site';

const phoneEventClass = `plausible-event-name=${EVENTS.ctaPhone.replaceAll(' ', '+')}`;
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

const isActive = (href: string) => currentPath === href;
const isGroupActive = (group: (typeof NAV)[number]) =>
  isActive(group.href) || (group.children?.some((c) => isActive(c.href)) ?? false);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Orderlyze – zur Startseite">
      <Image src={logo} alt="Orderlyze Logo" width={164} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {
          NAV.map((group) =>
            group.children ? (
              <li class:list={['nav__item nav__item--dropdown', { 'is-active': isGroupActive(group) }]}>
                <a href={group.href} class="nav__link" aria-haspopup="true">
                  {group.label}
                  <svg class="nav__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                </a>
                <ul class="nav__dropdown">
                  {group.children.map((child) => (
                    <li>
                      <a href={child.href} class:list={['nav__dropdown-link', { 'is-active': isActive(child.href) }]}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class:list={['nav__item', { 'is-active': isActive(group.href) }]}>
                <a href={group.href} class="nav__link">
                  {group.label}
                </a>
              </li>
            )
          )
        }
        {
          NAV_EXTRA.map((link) => (
            <li class="nav__item">
              <a href={link.href} class="nav__link" rel={link.external ? 'noopener' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={SITE.phoneHref} class:list={['header__phone', phoneEventClass]}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"
          />
        </svg>
        {SITE.phone}
      </a>
      <Button href="/angebot" event={EVENTS.ctaAngebot} class="header__cta">Kostenloses Angebot</Button>
    </div>

    <button class="header__burger" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile-Menü -->
  <div class="mobile" id="mobile-menu" hidden>
    <nav aria-label="Mobile Navigation">
      <ul class="mobile__list">
        {
          NAV.map((group) =>
            group.children ? (
              <li>
                <details class="mobile__group" open={isGroupActive(group)}>
                  <summary>{group.label}</summary>
                  <ul>
                    <li>
                      <a href={group.href} class="mobile__link mobile__link--overview">
                        {group.label} im Überblick
                      </a>
                    </li>
                    {group.children.map((child) => (
                      <li>
                        <a href={child.href} class="mobile__link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={group.href} class="mobile__link mobile__link--top">
                  {group.label}
                </a>
              </li>
            )
          )
        }
        {
          NAV_EXTRA.map((link) => (
            <li>
              <a href={link.href} class="mobile__link mobile__link--top" rel={link.external ? 'noopener' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile__actions">
        <Button href="/angebot" size="lg" event={EVENTS.ctaAngebot}>Kostenloses Angebot</Button>
        <Button href="/testen" size="lg" variant="secondary" event={EVENTS.ctaTesten}>
          Testen
        </Button>
        <a href={SITE.phoneHref} class:list={['mobile__phone', phoneEventClass]}>
          {SITE.phone} – kostenlos anrufen
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    toggle.classList.toggle('is-open', !open);
    if (menu) menu.hidden = open;
    document.documentElement.style.overflow = open ? '' : 'hidden';
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* kein backdrop-filter: würde zum Containing Block für das
       position:fixed-Mobile-Menü und schnitte es ab */
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    height: 4.4rem;
  }

  .header__logo {
    flex-shrink: 0;
    display: flex;
  }

  .header__logo img {
    width: 164px;
    height: auto;
  }

  /* ── Desktop-Nav ── */
  .nav {
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.96rem;
    color: var(--color-navy);
    text-decoration: none;
    border-radius: 6px;
    transition: background var(--transition), color var(--transition);
  }

  .nav__link:hover,
  .nav__item.is-active > .nav__link {
    color: var(--color-brand);
    background: var(--color-surface);
  }

  .nav__chevron {
    transition: transform var(--transition);
  }

  .nav__item--dropdown:hover .nav__chevron,
  .nav__item--dropdown:focus-within .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 16.5rem;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    box-shadow: var(--shadow-card-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  /* Hover-Brücke, damit das Menü beim Überfahren nicht zuklappt */
  .nav__item--dropdown::after {
    content: '';
    position: absolute;
    inset: 100% 0 -0.5rem 0;
  }

  .nav__item--dropdown:hover .nav__dropdown,
  .nav__item--dropdown:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__dropdown-link {
    display: block;
    padding: 0.55rem 0.85rem;
    font-size: 0.94rem;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-navy);
    text-decoration: none;
    border-radius: 7px;
    transition: background var(--transition), color var(--transition);
  }

  .nav__dropdown-link:hover,
  .nav__dropdown-link.is-active {
    background: var(--color-surface);
    color: var(--color-brand);
  }

  /* ── Aktionen rechts ── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--color-navy);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__phone:hover {
    color: var(--color-brand);
  }

  /* ── Burger ── */
  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin-left: auto;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .header__burger span {
    display: block;
    height: 2.5px;
    width: 100%;
    background: var(--color-navy);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  .header__burger.is-open span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }

  .header__burger.is-open span:nth-child(2) {
    opacity: 0;
  }

  .header__burger.is-open span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* ── Mobile-Menü ── */
  .mobile {
    position: fixed;
    inset: 4.4rem 0 0;
    background: #fff;
    overflow-y: auto;
    padding: 1.2rem 1.25rem 2.5rem;
    z-index: 49;
  }

  .mobile__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile__list > li {
    border-bottom: 1px solid var(--color-line);
  }

  .mobile__link,
  .mobile__group summary {
    display: block;
    padding: 0.95rem 0.25rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-navy);
    text-decoration: none;
    cursor: pointer;
  }

  .mobile__group summary {
    list-style: none;
    position: relative;
  }

  .mobile__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile__group summary::after {
    content: '';
    position: absolute;
    right: 0.6rem;
    top: 50%;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-heading-dark);
    border-bottom: 2px solid var(--color-heading-dark);
    transform: translateY(-70%) rotate(45deg);
    transition: transform var(--transition);
  }

  .mobile__group[open] summary::after {
    transform: translateY(-30%) rotate(225deg);
  }

  .mobile__group ul {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0 0 0 0.9rem;
  }

  .mobile__group .mobile__link {
    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.6rem 0.25rem;
    color: var(--color-heading-dark);
  }

  .mobile__link--overview {
    color: var(--color-brand) !important;
  }

  .mobile__actions {
    display: grid;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .mobile__phone {
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }

  /* ── Breakpoints ── */
  @media (max-width: 1100px) {
    .header__phone {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .nav,
    .header__actions {
      display: none;
    }

    .header__burger {
      display: flex;
    }
  }

  @media (min-width: 961px) {
    .mobile {
      display: none;
    }
  }
</style>
