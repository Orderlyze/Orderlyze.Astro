---
/**
 * Liste mit Brand-Häkchen — für Feature-Aufzählungen.
 */
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['checklist', className]}>
  {
    items.map((item) => (
      <li>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.14" />
          <path d="M5.8 10.4l2.6 2.6 5.6-5.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span set:html={item} />
      </li>
    ))
  }
</ul>

<style>
  .checklist {
    list-style: none;
    margin: 1.2rem 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    line-height: 1.55;
  }

  .checklist svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-brand);
  }

  :global(.section--navy) .checklist svg {
    color: var(--color-heading);
  }
</style>
