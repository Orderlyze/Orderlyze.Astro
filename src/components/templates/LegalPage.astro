---
/**
 * Template der Rechtsseiten (/agb, /impressum, /datenschutzerklaerung).
 * Rechtstexte 1:1 aus src/content/legal/* (Quelle: planning/content/pages/).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  h1: string;
  title: string;
  description: string;
  canonical: string;
  /** Untertitel unter der H1 */
  intro?: string;
}

const { h1, title, description, canonical, intro } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <header class="legal-hero">
    <div class="container legal-hero__inner">
      <p class="legal-hero__eyebrow">Rechtliches</p>
      <h1>{h1}</h1>
      {intro && <p class="legal-hero__intro">{intro}</p>}
    </div>
  </header>

  <div class="container legal-body">
    <article class="legal-prose">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .legal-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }

  .legal-hero__inner {
    max-width: var(--container-narrow);
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .legal-hero__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-heading-dark);
    margin: 0 0 0.7rem;
  }

  .legal-hero h1 {
    margin-bottom: 0;
  }

  .legal-hero__intro {
    margin: 0.8rem 0 0;
    color: var(--color-text-muted);
  }

  .legal-body {
    max-width: var(--container-narrow);
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .legal-prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.2em;
    padding-top: 1.1em;
    border-top: 1px solid var(--color-line);
  }

  .legal-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .legal-prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.6em;
  }

  .legal-prose :global(p) {
    color: var(--color-text);
    line-height: 1.75;
  }

  .legal-prose :global(a) {
    word-break: break-word;
  }
</style>
