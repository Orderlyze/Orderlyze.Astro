---
/**
 * Abschluss-CTA-Sektion (helle Fläche mit Punktraster + blauer Akzentlinie).
 * Standard-Wortlaut der Live-Seite, per Props überschreibbar.
 */
import Button from './Button.astro';
import { EVENTS, SITE } from '../config/site';

interface Props {
  title?: string;
  mark?: string;
  buttonLabel?: string;
  note?: string;
  showPhone?: boolean;
}

const {
  title = 'Hol dir jetzt ein kostenloses Angebot!',
  mark = 'kostenloses',
  buttonLabel = 'Angebot anfordern',
  note = 'Kostenlos und unverbindlich.',
  showPhone = true,
} = Astro.props;

const parts = mark && title.includes(mark) ? title.split(mark) : null;
const phoneEventClass = `plausible-event-name=${EVENTS.ctaPhone.replaceAll(' ', '+')}`;
---

<section class="cta-banner">
  <div class="container cta-banner__inner reveal">
    <h2 class="cta-banner__title">
      {parts ? (
        <>
          {parts[0]}<span class="cta-banner__mark">{mark}</span>{parts[1]}
        </>
      ) : (
        title
      )}
    </h2>
    <div class="cta-banner__actions">
      <Button href="/angebot" size="lg" event={EVENTS.ctaAngebot}>
        {buttonLabel}
      </Button>
      {
        showPhone && (
          <a href={SITE.phoneHref} class:list={['cta-banner__phone', phoneEventClass]}>
            oder anrufen: <strong>{SITE.phone}</strong>
          </a>
        )
      }
    </div>
    <p class="cta-banner__note">{note}</p>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-surface);
    background-image: radial-gradient(rgba(6, 89, 169, 0.09) 1px, transparent 1px);
    background-size: 26px 26px;
    padding-block: var(--space-section-sm);
    border-top: 4px solid var(--color-brand);
  }

  .cta-banner__inner {
    text-align: center;
    max-width: 46rem;
  }

  .cta-banner__title {
    color: var(--color-navy);
    font-size: var(--text-h2);
    margin-bottom: 1.4rem;
  }

  .cta-banner__mark {
    color: var(--color-brand);
  }

  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
  }

  .cta-banner__phone {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1rem;
  }

  .cta-banner__phone strong {
    color: var(--color-navy);
    font-family: var(--font-heading);
  }

  .cta-banner__phone:hover strong {
    color: var(--color-brand);
  }

  .cta-banner__note {
    margin: 1.1rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
