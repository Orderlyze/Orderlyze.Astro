---
/**
 * Floating WhatsApp-Support-Button — fix unten rechts auf allen Seiten mit
 * Chrome. Ziel-Nummer + wa.me-Link aus src/config/site.ts. Klick feuert das
 * Plausible-Goal EVENTS.ctaWhatsApp.
 */
import { SITE, EVENTS } from '../config/site';

const eventClass = `plausible-event-name=${EVENTS.ctaWhatsApp.replaceAll(' ', '+')}`;
---

<a
  href={SITE.whatsappHref}
  class:list={['whatsapp-fab', eventClass]}
  target="_blank"
  rel="noopener"
  aria-label={`Support über WhatsApp – ${SITE.whatsapp}`}
  title="WhatsApp-Support"
>
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.78 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.02ZM12.04 20.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.25 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42-.14-.01-.31-.01-.48-.01a.92.92 0 0 0-.67.31c-.23.25-.88.86-.88 2.1 0 1.24.9 2.43 1.03 2.6.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.6.19 1.15.16 1.59.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"
    ></path>
  </svg>
  <span class="whatsapp-fab__label">WhatsApp-Support</span>
</a>

<script>
  // Nach kurzem Scrollen zur reinen Icon-Bubble einklappen, damit der FAB
  // keine Inhalte verdeckt (Preiskarten auf /preise, Formulare); Hover/Fokus
  // klappt das Label wieder aus.
  const fab = document.querySelector('.whatsapp-fab');
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        fab?.classList.toggle('is-compact', window.scrollY > 160);
        ticking = false;
      });
    },
    { passive: true }
  );
</script>

<style>
  .whatsapp-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 56px;
    padding: 0 1rem;
    border-radius: 999px;
    background: #25d366;
    /* Dunkles Grün statt Weiß: 7,1:1 auf WhatsApp-Grün (WCAG AA; Weiß wäre 1,98:1) */
    color: #06331a;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .whatsapp-fab:hover {
    background: #1ebe5b;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
  }

  .whatsapp-fab:focus-visible {
    outline: 3px solid #06331a;
    outline-offset: 2px;
  }

  .whatsapp-fab svg {
    flex: none;
  }

  .whatsapp-fab__label {
    font-family: 'Raleway Variable', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    max-width: 12rem;
    overflow: hidden;
    transition: max-width 0.25s ease, opacity 0.2s ease;
  }

  /* Eingeklappter Zustand (nach Scroll): nur noch runde Icon-Bubble */
  .whatsapp-fab.is-compact:not(:hover):not(:focus-visible) {
    padding: 0;
    width: 56px;
    justify-content: center;
  }

  .whatsapp-fab.is-compact:not(:hover):not(:focus-visible) .whatsapp-fab__label {
    max-width: 0;
    opacity: 0;
  }

  /* Auf kleinen Screens nur das runde Icon zeigen */
  @media (max-width: 600px) {
    .whatsapp-fab {
      right: 1rem;
      bottom: 1rem;
      padding: 0;
      width: 56px;
      justify-content: center;
    }
    .whatsapp-fab__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
    .whatsapp-fab:hover {
      transform: none;
    }
  }
</style>
