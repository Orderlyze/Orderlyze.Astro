---
/**
 * Hardware-Pakete & Zubehör — geteilt von /hardware und /preise.
 * Preise/Daten: planning/content/pages/{hardware,preise}.md
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

import tabletSamsung from '../assets/hardware/tablet-samsung-galaxy-tab-a8.webp';
import tabletIpad from '../assets/hardware/tablet-ipad.png';
import bondrucker from '../assets/hardware/bondrucker.png';
import staender from '../assets/hardware/tablet-staender.png';
import kassenladeK2 from '../assets/hardware/kassenlade-k2.png';

interface Props {
  /** Anzeigename des Samsung-Tablets (alte Seite: "Samsung Tab A8", Preise-Seite: "Samsung Tab A9+") */
  samsungName?: string;
  /** Zusatz hinter dem Drucker-Preis, z. B. " (Cloud: 265€)" */
  druckerZusatz?: string;
}

const { samsungName = 'Samsung Tab A8', druckerZusatz = '' } = Astro.props;

interface Teil {
  img: ImageMetadata;
  alt: string;
  label: string;
}

const teile = {
  samsung: { img: tabletSamsung, alt: 'Samsung Galaxy Tablet', label: samsungName },
  ipad: { img: tabletIpad, alt: 'Apple iPad 9. Generation', label: 'iPad 9. Generation' },
  drucker: { img: bondrucker, alt: 'Bondrucker', label: 'Bondrucker' },
  staender: { img: staender, alt: 'Tablet-Ständer', label: 'Tablet Ständer' },
  kassenlade: { img: kassenladeK2, alt: 'Kassenlade K-2', label: 'Kassenlade K-2' },
} satisfies Record<string, Teil>;

interface Bundle {
  name: string;
  parts: Teil[];
  zeilen?: { label: string; preis: string }[];
  gesamt: string;
}

const bundles: Bundle[] = [
  {
    name: 'Tablet Kassensystem',
    parts: [teile.samsung, teile.drucker],
    zeilen: [
      { label: samsungName, preis: '205,90€' },
      { label: `Bondrucker Bluetooth${druckerZusatz}`, preis: '220€' },
    ],
    gesamt: '425,90€',
  },
  {
    name: 'Samsung Kassensystem Paket 1',
    parts: [teile.samsung, teile.drucker, teile.staender],
    gesamt: '448,80€',
  },
  {
    name: 'Samsung Kassensystem Paket 2',
    parts: [teile.samsung, teile.staender, teile.drucker, teile.kassenlade],
    gesamt: '534,40€',
  },
  {
    name: 'iPad Kassensystem',
    parts: [teile.ipad, teile.drucker],
    zeilen: [
      { label: 'iPad 9. Generation', preis: '369,90€' },
      { label: `Bondrucker Bluetooth${druckerZusatz}`, preis: '220€' },
    ],
    gesamt: '589,90€',
  },
  {
    name: 'iPad Kassensystem Paket 1',
    parts: [teile.ipad, teile.drucker, teile.staender],
    gesamt: '612,80€',
  },
  {
    name: 'iPad Kassensystem Paket 2',
    parts: [teile.ipad, teile.staender, teile.drucker, teile.kassenlade],
    gesamt: '698,40€',
  },
];
---

<div class="bundles">
  {
    bundles.map((b) => (
      <article class="bundle reveal">
        <h3 class="bundle__name">{b.name}</h3>
        <div class="bundle__parts">
          {b.parts.map((p, i) => (
            <>
              {i > 0 && <span class="bundle__plus" aria-hidden="true">+</span>}
              <figure class="bundle__part">
                <Image src={p.img} alt={p.alt} widths={[160, 320]} width={320} sizes="120px" />
                <figcaption>{p.label}</figcaption>
              </figure>
            </>
          ))}
        </div>
        {b.zeilen && (
          <ul class="bundle__zeilen">
            {b.zeilen.map((z) => (
              <li>
                <span>{z.label}</span>
                <span class="bundle__zeile-preis">{z.preis}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="bundle__gesamt">
          <span>Gesamt</span>
          <strong>{b.gesamt}</strong>
        </div>
        <Button href="/bestellen" class="bundle__cta">Jetzt bestellen</Button>
      </article>
    ))
  }
</div>

<style>
  .bundles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.3rem, 2vw, 2rem);
  }

  .bundle {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.7rem 1.5rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .bundle:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .bundle__name {
    font-size: 1.15rem;
    text-align: center;
    margin-bottom: 1.2rem;
  }

  .bundle__parts {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 7.5rem;
    margin-bottom: 1.2rem;
  }

  .bundle__part {
    margin: 0;
    text-align: center;
    width: 5.6rem;
  }

  .bundle__part :global(img) {
    height: 4.4rem;
    width: auto;
    margin-inline: auto;
    object-fit: contain;
  }

  .bundle__part figcaption {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
    line-height: 1.3;
  }

  .bundle__plus {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-heading);
  }

  .bundle__zeilen {
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .bundle__zeilen li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0;
  }

  .bundle__zeile-preis {
    font-family: var(--font-mono);
  }

  .bundle__gesamt {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 2px dashed var(--color-line);
    padding-top: 0.9rem;
    margin-top: auto;
    margin-bottom: 1.1rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .bundle__gesamt strong {
    font-family: var(--font-mono);
    font-size: 1.45rem;
    color: var(--color-navy);
  }

  .bundle__cta {
    width: 100%;
  }

  @media (max-width: 1000px) {
    .bundles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .bundles {
      grid-template-columns: 1fr;
    }
  }
</style>
