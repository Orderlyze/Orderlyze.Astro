---
import { withBasePath } from '../../lib/url';

type Props = {
  title: string;
  cta: { label: string; href: string };
  note?: string;
};

const { title, cta, note } = Astro.props;
---

<section class="blue-cta">
  <div class="blue-cta-inner">
    <h2>{title}</h2>
    <a class="blue-cta-button" href={withBasePath(cta.href)}>{cta.label}</a>
    {note && <p class="blue-cta-note">{note}</p>}
  </div>
</section>

<style>
  .blue-cta {
    background: var(--accent);
    color: white;
    padding: clamp(56px, 8vw, 96px) 20px;
  }

  .blue-cta-inner {
    display: grid;
    justify-items: center;
    gap: 22px;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .blue-cta h2 {
    margin: 0;
    color: white;
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 36px);
    line-height: 1.3;
  }

  .blue-cta-button {
    background: white;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    padding: 0 32px;
    height: 50px;
    line-height: 50px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .blue-cta-button:hover {
    background: #e5edf7;
    color: var(--accent);
  }

  .blue-cta-note {
    margin: 0;
    color: rgb(255 255 255 / 85%);
    font-size: 0.92rem;
  }
</style>
