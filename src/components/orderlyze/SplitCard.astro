---
import { withBasePath } from '../../lib/url';

type Props = {
  title: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  imageSide?: 'left' | 'right';
  bullets?: string[];
  cta?: { label: string; href: string; style?: 'solid' | 'outline' };
  variant?: 'card' | 'plain';
  background?: 'white' | 'soft';
};

const {
  title,
  body,
  image,
  imageAlt = title,
  imageSide = 'right',
  bullets,
  cta,
  variant = 'card',
  background = 'white',
} = Astro.props;

const ctaStyle = cta?.style ?? 'solid';
---

<section class="split-section" data-bg={background}>
  <article class="split" data-variant={variant} data-side={image ? imageSide : 'none'}>
    {image && (
      <figure class="split-figure">
        <img src={withBasePath(image)} alt={imageAlt} width="900" height="700" loading="lazy" decoding="async" />
      </figure>
    )}
    <div class="split-body">
      <h2>{title}</h2>
      {body && <p>{body}</p>}
      {bullets && bullets.length > 0 && (
        <ul class="split-bullets">
          {bullets.map((b) => (
            <li>
              <span class="split-tick" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14">
                  <path fill="currentColor" d="M6.3 11.5 2.7 7.9l1.4-1.4 2.2 2.2 5.6-5.6 1.4 1.4z" />
                </svg>
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )}
      {cta && (
        <a class:list={['split-cta', ctaStyle]} href={withBasePath(cta.href)}>{cta.label}</a>
      )}
    </div>
  </article>
</section>

<style>
  .split-section {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }

  .split-section[data-bg='soft'] {
    background: #fafafa;
  }

  .split-section[data-bg='white'] {
    background: white;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .split[data-side='left'] .split-figure {
    order: -1;
  }

  .split[data-side='none'] {
    grid-template-columns: 1fr;
    max-width: 760px;
    text-align: center;
    justify-items: center;
  }

  .split-figure {
    margin: 0;
  }

  .split-figure img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    display: block;
  }

  .split-body h2 {
    margin: 0 0 12px;
    color: var(--brand-blue);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 32px);
    line-height: 1.3;
  }

  .split-body p {
    margin: 0;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  .split-bullets {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .split-bullets li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: start;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .split-tick {
    color: var(--accent);
    margin-top: 2px;
  }

  .split-cta {
    display: inline-block;
    margin-top: 22px;
    height: 46px;
    line-height: 46px;
    padding: 0 26px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
    font-size: 0.86rem;
    text-decoration: none;
  }

  .split-cta.solid {
    background: var(--accent);
    color: white;
  }

  .split-cta.solid:hover {
    background: #044d8c;
  }

  .split-cta.outline {
    border: 2px solid var(--accent);
    color: var(--accent);
    background: white;
    line-height: 42px;
  }

  .split-cta.outline:hover {
    background: var(--accent);
    color: white;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }

    .split[data-side='left'] .split-figure {
      order: 0;
    }
  }
</style>
