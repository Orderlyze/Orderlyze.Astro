---
import BlueCta from './BlueCta.astro';
import { withBasePath } from '../../lib/url';
import type { HelpArticle } from '../../lib/help-articles';

type Props = { article: HelpArticle };
const { article } = Astro.props;
---

<section class="help-hero">
  <h1>{article.shortTitle}</h1>
</section>

<section class="article-band">
  <div class="article-body">
    <p class="lead">{article.description}</p>
    <ol class="step-list">
      {article.body.map((para, i) => (
        <li>
          <span class="step-num">{i + 1}</span>
          <div class="step-text">{para}</div>
        </li>
      ))}
    </ol>
    <a class="back-link" href={withBasePath('/support/')}>← zurück zur Hilfe-Übersicht</a>
  </div>
</section>

<BlueCta
  title="Du brauchst Hilfe? Kontaktiere uns."
  cta={{ label: '0800 400 4511', href: 'tel:08004004511' }}
  note="Telefonisch, per E-Mail und WhatsApp erreichbar."
/>

<style>
  .help-hero {
    padding: clamp(40px, 6vw, 64px) max(24px, calc((100vw - 1180px) / 2));
    background: var(--accent);
    color: white;
    text-align: center;
  }

  .help-hero h1 {
    margin: 0;
    color: white;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.15;
  }

  .article-band {
    padding: clamp(32px, 5vw, 64px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .article-body {
    max-width: 820px;
    margin: 0 auto;
  }

  .article-body .lead {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.55;
    margin: 0 auto 28px;
    text-align: center;
    max-width: 680px;
  }

  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  .step-list li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 20px 22px;
  }

  .step-num {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: white;
    border-radius: 999px;
    font-weight: 900;
    font-size: 1rem;
    line-height: 1;
  }

  .step-text {
    color: #374151;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .back-link {
    display: inline-block;
    margin-top: 28px;
    color: var(--accent);
    font-weight: 800;
    text-decoration: none;
    font-size: 0.92rem;
  }

  .back-link:hover { text-decoration: underline; }
</style>
