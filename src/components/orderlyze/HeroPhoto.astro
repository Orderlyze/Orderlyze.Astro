---
import { withBasePath } from '../../lib/url';

type Props = {
  image: string;
  title: string;
  cta?: { label: string; href: string };
  alignment?: 'center' | 'left';
  overlay?: 'light' | 'medium' | 'dark';
};

const { image, title, cta, alignment = 'center', overlay = 'medium' } = Astro.props;
const overlayBg =
  overlay === 'light'
    ? 'linear-gradient(180deg, rgb(11 18 32 / 18%) 0%, rgb(11 18 32 / 40%) 100%)'
    : overlay === 'dark'
      ? 'linear-gradient(180deg, rgb(11 18 32 / 45%) 0%, rgb(11 18 32 / 78%) 100%)'
      : 'linear-gradient(180deg, rgb(11 18 32 / 32%) 0%, rgb(11 18 32 / 60%) 100%)';
---

<section class="hero-photo" data-align={alignment}>
  <img class="hero-photo-image" src={withBasePath(image)} alt={title} width="1920" height="900" loading="eager" decoding="async" />
  <div class="hero-photo-overlay" aria-hidden="true" style={`background:${overlayBg}`}></div>
  <div class="hero-photo-content">
    <h1>{title}</h1>
    {cta && <a class="hero-photo-cta" href={withBasePath(cta.href)}>{cta.label}</a>}
  </div>
</section>

<style>
  .hero-photo {
    position: relative;
    min-height: clamp(240px, 32vh, 340px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #0b1220;
    color: white;
    isolation: isolate;
  }

  .hero-photo[data-align='left'] {
    place-items: center start;
    text-align: left;
  }

  .hero-photo[data-align='center'] {
    text-align: center;
  }

  .hero-photo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-photo-content {
    display: grid;
    gap: 18px;
    padding: clamp(32px, 5vw, 56px) max(24px, calc((100vw - 1180px) / 2));
    max-width: 1180px;
    width: 100%;
    justify-items: var(--align-items, center);
  }

  .hero-photo[data-align='left'] .hero-photo-content {
    --align-items: start;
  }

  .hero-photo h1 {
    margin: 0;
    color: white;
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.8rem, 3.8vw, 50px);
    line-height: 1.2;
    letter-spacing: 0;
    text-shadow: 0 2px 12px rgb(0 0 0 / 35%);
    max-width: 22ch;
  }

  .hero-photo-cta {
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    padding: 0 26px;
    height: 44px;
    line-height: 44px;
    border-radius: 999px;
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .hero-photo-cta:hover {
    background: #044d8c;
  }
</style>
