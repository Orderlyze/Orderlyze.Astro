---
import HeroPhoto from './HeroPhoto.astro';
import SectionHeading from './SectionHeading.astro';
import SplitCard from './SplitCard.astro';
import FeatureGrid from './FeatureGrid.astro';
import Testimonials from './Testimonials.astro';
import BlueCta from './BlueCta.astro';
import { withBasePath } from '../../lib/url';

type Props = {
  term: string; // e.g. "Registrierkasse", "Kassensoftware"
  termArticle?: string; // "die" | "das" | "der"
  heroTitle: string;
  introHeading: string;
  ctaTitle: string;
  heroImage?: string;
};

const {
  term,
  termArticle = 'das',
  heroTitle,
  introHeading,
  ctaTitle,
  heroImage = '/images/orderlyze/checkout-counter.jpg',
} = Astro.props;

const compliance = ['GoBD', 'RKSV', 'KassenSichV', '256-bit Verschlüsselung', 'tägliches Backup', 'EU-Datenschutz'];
---

<HeroPhoto image={heroImage} title={heroTitle} cta={{ label: 'Angebot anfordern', href: '/angebot/' }} overlay="dark" />

<section class="band band-soft">
  <SectionHeading title={introHeading} />
  <p class="intro-lead">
    Egal ob Gastronomie, Friseursalon oder eine sonstige Dienstleistung. Mit {termArticle} Orderlyze {term} arbeitest du einfach und schnell, damit du dich auf das Wichtigste konzentrieren kannst: Deine Kunden!
  </p>
  <div class="icon-row">
    <article class="icon-tile">
      <h3>Synchronisation</h3>
      <p>Ob unterwegs oder im eigenen Gebäude – Rechnungen erstellen ist nie ein Problem.</p>
    </article>
    <article class="icon-tile">
      <h3>Für jeden Bedarf</h3>
      <p>Einzelunternehmen oder Großbetrieb – wir haben eine individuelle Lösung.</p>
    </article>
    <article class="icon-tile">
      <h3>Volle Kontrolle</h3>
      <p>Geschäftszahlen analysieren, Mitarbeiter und Finanzamteinstellungen verwalten.</p>
    </article>
  </div>
</section>

<SplitCard
  background="white"
  image="/images/orderlyze/checkout-counter.jpg"
  imageSide="right"
  title="Sekundenschnell kassieren"
  body={`Mit ${termArticle === 'die' ? 'der' : termArticle === 'der' ? 'dem' : 'dem'} Orderlyze ${term} erstellst du Rechnungen in Sekundenschnelle, ganz ohne langes Einarbeiten. Produkte mit nur zwei Klicks hinzufügen, löschen und bearbeiten. Schnell und unkompliziert abrechnen, Bestellungen stornieren. So geht Kassieren heute!`}
/>

<SplitCard
  background="soft"
  image="/images/orderlyze/app-phone.png"
  imageSide="left"
  title="Bequem und mühelos bedienen"
  body="Eine App, wie sie sein sollte: Sofort zu verstehen, einfach zu bedienen, effizient und das Wichtigste, immer auf dem neuesten Stand."
/>

<SplitCard
  background="white"
  image="/images/orderlyze/accounting.jpg"
  imageSide="right"
  title="Übersichtlich und transparent"
  body="Orderlyze bietet dir die Möglichkeit, dein Unternehmen zu verwalten, zu analysieren und zu organisieren – alles individuell und nach deinem Geschmack."
  cta={{ label: 'Mehr zur Verwaltung', href: '/verwaltung/', style: 'outline' }}
/>

<SplitCard
  background="soft"
  image="/images/orderlyze/accounting.jpg"
  imageSide="left"
  title="Buchhaltung ohne viel Mühe."
  body="Im stressigen Alltag auch noch die Buchhaltung machen? Nicht bei uns. Mit wenigen Klicks Berichte für deine SteuerberaterIn exportieren."
  cta={{ label: 'Mehr erfahren', href: '/datenexport-steuerberater/', style: 'outline' }}
/>

<SplitCard
  background="white"
  image="/images/orderlyze/card-payment.jpg"
  imageSide="right"
  title="Integrierte Kartenzahlung."
  body="Für schnelles und effizientes Abrechnen. Mit Orderlyze nimmst du jede Zahlungsmethode entgegen."
  cta={{ label: 'Mehr zur Kartenzahlung', href: '/kartenzahlung/', style: 'outline' }}
/>

<SplitCard
  background="soft"
  image="/images/orderlyze/checkout-counter.jpg"
  imageSide="left"
  title="Kommunikation mit der Küche"
  body="Mit nur einem Klick werden Bestellungen an die Küche gesendet. Spar dir enorm viele Wege, Zeit und Geld."
  cta={{ label: 'Mehr zum Funkbonieren', href: '/funkbonieren/', style: 'outline' }}
/>

<section class="mid-banner">
  <div class="mid-banner-inner">
    <h2>Hol dir ein kostenloses Angebot</h2>
    <a class="mid-cta" href={withBasePath('/angebot/')}>Angebot anfordern</a>
    <p>Kostenlos und Unverbindlich.</p>
  </div>
</section>

<section class="band band-white">
  <SectionHeading title="Bei uns sind deine Daten sicher und konform" />
  <p class="intro-lead">Erfahre, was GoBD, RKSV und KassenSichV bedeutet, und welche Vorteile unsere Zertifizierungen haben.</p>
  <FeatureGrid items={compliance} columns={3} />
</section>

<Testimonials
  items={[
    {
      name: 'Verena S.',
      role: 'Salonbesitzerin',
      copy: 'Orderlyze hat mir den Alltag wirklich sehr erleichtert. Ich gewinne sehr viel Zeit und keiner meiner MitarbeiterInnen hat Probleme bei der Bedienung. Außerdem ist die Hardware sehr günstig gewesen.',
      image: '/images/orderlyze/customer-helene.jpg',
    },
  ]}
/>

<section class="band band-soft">
  <SectionHeading title="Viele Funktionen warten auf dich" />
  <div class="fn-tiles">
    <a class="fn-tile" href={withBasePath('/kartenzahlung/')}><h3>Kartenzahlung</h3><p>EC, Apple Pay, kontaktlos</p></a>
    <a class="fn-tile" href={withBasePath('/funkbonieren/')}><h3>Funkbonieren</h3><p>Bestellungen in Küche & Bar</p></a>
    <a class="fn-tile" href={withBasePath('/verwaltung/')}><h3>Verwaltung</h3><p>Produkte, Berichte, Personal</p></a>
    <a class="fn-tile" href={withBasePath('/datenexport-steuerberater/')}><h3>Datenexport</h3><p>DATEV, BMD, RZL</p></a>
  </div>
</section>

<section class="band band-white">
  <div class="support-card">
    <div>
      <h2>Entdecke eine bessere Art zu arbeiten</h2>
      <p>Unser Team unterstützt dich bei Einrichtung, Verwaltung und im Alltag — telefonisch, per E-Mail und WhatsApp. Kostenloser Premium Support für alle.</p>
      <a class="solid-cta" href={withBasePath('/so-funktionierts/')}>So funktioniert's</a>
    </div>
    <img src={withBasePath('/images/orderlyze/support.jpg')} alt="Premium Support" width="640" height="440" loading="lazy" />
  </div>
</section>

<BlueCta
  title={ctaTitle}
  cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
  note="Kostenlos und Unverbindlich."
/>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }
  .band-soft { background: #fafafa; }
  .band-white { background: white; }

  .intro-lead {
    max-width: 760px;
    margin: -10px auto 26px;
    color: #4b5563;
    text-align: center;
    font-size: 1rem;
    line-height: 1.6;
  }

  .icon-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-width: 980px;
    margin: 0 auto;
  }

  .icon-tile {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 22px 20px;
    text-align: center;
  }

  .icon-tile h3 {
    margin: 0 0 6px;
    color: var(--brand-blue-dark);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: 22px;
  }

  .icon-tile p {
    margin: 0;
    color: #4b5563;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .mid-banner {
    padding: clamp(36px, 5vw, 56px) 24px;
    background: #fafafa;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }

  .mid-banner-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .mid-banner h2 {
    margin: 0 0 16px;
    color: var(--brand-blue-dark);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 3.4vw, 40px);
    line-height: 1.4;
  }

  .mid-cta {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 26px;
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    font-size: 0.84rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .mid-cta:hover { background: #044d8c; }

  .mid-banner p {
    margin: 12px 0 0;
    color: #6b7280;
    font-size: 0.86rem;
  }

  .fn-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .fn-tile {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 20px 18px;
    text-decoration: none;
    color: inherit;
  }

  .fn-tile:hover { border-color: var(--accent); }

  .fn-tile h3 {
    margin: 0 0 4px;
    color: var(--brand-blue-dark);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: 18px;
  }

  .fn-tile p {
    margin: 0;
    color: #4b5563;
    font-size: 0.86rem;
  }

  .support-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .support-card h2 {
    margin: 0 0 12px;
    color: var(--brand-blue-dark);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 3vw, 35px);
    line-height: 1.4;
  }

  .support-card p {
    margin: 0 0 18px;
    color: #4b5563;
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 480px;
  }

  .support-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }

  .solid-cta {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    height: 44px;
    line-height: 44px;
    padding: 0 26px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.82rem;
  }

  .solid-cta:hover { background: #044d8c; }

  @media (max-width: 900px) {
    .icon-row { grid-template-columns: 1fr; }
    .fn-tiles { grid-template-columns: repeat(2, 1fr); }
    .support-card { grid-template-columns: 1fr; }
  }
</style>
