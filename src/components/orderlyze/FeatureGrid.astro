---
type Props = {
  title?: string;
  items: string[];
  columns?: 2 | 3 | 4;
};

const { title, items, columns = 4 } = Astro.props;
---

<div class="feature-grid" data-cols={columns}>
  {title && <h3 class="feature-grid-title">{title}</h3>}
  <ul>
    {items.map((item) => (
      <li>
        <span class="tick" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <path fill="currentColor" d="M6.3 11.5 2.7 7.9l1.4-1.4 2.2 2.2 5.6-5.6 1.4 1.4z" />
          </svg>
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .feature-grid {
    max-width: 1080px;
    margin: 0 auto 36px;
    padding: 0 24px;
  }

  .feature-grid-title {
    margin: 0 0 18px;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 800;
    text-align: center;
  }

  .feature-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px 28px;
  }

  .feature-grid[data-cols='2'] ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .feature-grid[data-cols='3'] ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .feature-grid[data-cols='4'] ul { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .feature-grid li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .tick {
    color: var(--accent);
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .feature-grid[data-cols='4'] ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feature-grid[data-cols='3'] ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 540px) {
    .feature-grid ul { grid-template-columns: 1fr; }
  }
</style>
