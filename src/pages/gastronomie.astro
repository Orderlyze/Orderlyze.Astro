---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoLanding from '../components/orderlyze/SeoLanding.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Kassensystem für die Gastronomie | Orderlyze';
const description = 'Das Nr 1. Kassensystem für die Gastronomie. Funkbonieren, Kartenzahlung, RKSV und KassenSichV konform.';
const canonical = '/gastronomie/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout title={title} description={description} canonical={canonical} image="/images/orderlyze/branch-restaurant.jpg"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: new URL(canonical, siteUrl).toString(), inLanguage: 'de-DE' }}>
  <SeoLanding
    term="Kassensystem"
    termArticle="dem"
    heroTitle={'Das Nr 1. Kassensystem für die Gastronomie'}
    introHeading="Genau das Richtige für deine Gastronomie"
    ctaTitle="Hol dir ein individuelles Angebot für deine Gastronomie"
    heroImage="/images/orderlyze/branch-restaurant.jpg"
  />
</BaseLayout>
