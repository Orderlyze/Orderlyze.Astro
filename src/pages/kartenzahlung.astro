---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import SectionHeading from '../components/orderlyze/SectionHeading.astro';
import SplitCard from '../components/orderlyze/SplitCard.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Kartenzahlung | Orderlyze';
const description =
  'Mit Orderlyze bist du für jede Zahlungsmethode gerüstet. Kartenzahlung, Apple Pay, kontaktlos per NFC – einfach eingerichtet und schnell abgerechnet.';
const canonical = '/kartenzahlung/';
const siteUrl = absoluteSiteUrl(Astro.site);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Kartenzahlung', item: new URL(canonical, siteUrl).toString() },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/card-payment.jpg"
  jsonLd={jsonLd}
>
  <HeroPhoto
    image="/images/orderlyze/card-payment.jpg"
    title="Kartenzahlung"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    overlay="dark"
  />

  <section class="band band-soft">
    <SectionHeading title={'Bereit, deinen Umsatz zu steigern?'} />
    <p class="intro-lead">
      Bist du bereits für jede Zahlungsmethode gerüstet? Immer mehr Kunden bevorzugen es, bargeldlos zu bezahlen,
      vor allem weil es bequem, schnell und sicher ist. Mit Orderlyze kannst du deinen KundInnen genau das bieten.
      Kartenzahlung ist bei uns wirklich einfach und ist schnell eingerichtet.
    </p>
  </section>

  <SplitCard
    background="white"
    image="/images/orderlyze/card-payment.jpg"
    imageSide="right"
    title="Kartenzahlung? Kein Problem"
    body="Bargeldlos zu bezahlen wird immer beliebter und hat für dich und deine KundInnen viele Vorteile. Mit Orderlyze bist du für jede Zahlungsmethode gerüstet und kannst diverse Zahlungen ganz einfach entgegennehmen."
    bullets={[
      'EC, Maestro/V Pay, MasterCard und Visa',
      'Apple Pay',
      'Kontaktlose Zahlung per NFC',
    ]}
  />

  <SplitCard
    background="soft"
    image="/images/orderlyze/checkout-counter.jpg"
    imageSide="left"
    title={'Effizient arbeiten. Und Kunden zufriedenstellen.'}
    body="Effizientes Abrechnen für größere Flexibilität und mehr Umsatz. Mit Orderlyze sparst du Zeit beim Kassieren und deine Gäste sind in Sekunden zufrieden bedient."
  />

  <SplitCard
    background="white"
    variant="plain"
    title="Bargeldlos und kontaktlos bezahlen. So einfach wie noch nie."
    body="Die Technologie NFC (Near Field Communication) ermöglicht bargeldloses und kontaktloses Bezahlen über Smartphone-Apps wie Apple Pay oder Google Pay oder durch Berühren des Kartenlesegeräts mit der Karte. Durch den Einsatz von NFC sparen sowohl Gastronomen als auch Gäste Zeit im Vergleich zu Bargeldzahlungen. Zusätzlich erleichtert bargeldloses Bezahlen die Buchhaltung und reduziert den Aufwand für Wechselgeld, Sortieren des Geldes und Kassenbuchführung."
  />

  <section class="band band-soft">
    <SectionHeading title={'Mit Orderlyze ist Kartenzahlung wirklich einfach.'} size="md" />
    <div class="terminal-grid">
      <article class="terminal-card">
        <h3>Mobiles Kartenterminal</h3>
        <p>Verbinde dein Smartphone oder Tablet mit dem mobilen Kartenterminal und nimm Zahlungen flexibel überall entgegen.</p>
      </article>
      <article class="terminal-card">
        <h3>Sunmi V2 Pro</h3>
        <p>Kartenzahlung, Drucker und Kassensystem – alles in einem All-in-One Gerät. Einfach, robust und überall einsetzbar.</p>
      </article>
    </div>
  </section>

  <BlueCta
    title={'Kassensystem mit Kartenzahlung? Hol dir von uns ein kostenloses Angebot.'}
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }

  .band-soft {
    background: #fafafa;
  }

  .intro-lead {
    max-width: 760px;
    margin: 0 auto;
    color: var(--muted);
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .terminal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    max-width: 880px;
    margin: 0 auto;
  }

  .terminal-card {
    background: white;
    border-radius: 14px;
    box-shadow: 0 16px 40px rgb(15 23 42 / 8%);
    padding: 28px;
  }

  .terminal-card h3 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 1.25rem;
  }

  .terminal-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .terminal-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
