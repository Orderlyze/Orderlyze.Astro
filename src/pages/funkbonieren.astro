---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import SectionHeading from '../components/orderlyze/SectionHeading.astro';
import SplitCard from '../components/orderlyze/SplitCard.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Funkbonieren | Orderlyze';
const description =
  'Mit Funkbonieren werden Bestellungen sofort in die Küche oder zur Bar gesendet. Steigere Umsatz, spare Personalkosten und biete besseren Service.';
const canonical = '/funkbonieren/';
const siteUrl = absoluteSiteUrl(Astro.site);

const benefits = [
  { title: 'Umsatz um bis zu 20% steigern', text: 'Reduzierte Wartezeiten = mehr Tischwechsel, mehr Bestellungen und höhere Umsätze in Stoßzeiten.' },
  { title: 'Bester Service für deine Gäste', text: 'Mobile Bestellaufnahme vermeidet lange Wartezeiten und vergeblich ausgelieferte Bestellungen.' },
  { title: 'Personalkosten um 50% senken', text: 'Bessere Arbeitsteilung des Personals – erfahrene Servicekräfte arbeiten direkt am Gast, Runner unterstützen.' },
  { title: 'Wenige Minuten Einarbeitungszeit', text: 'Mitarbeiter sind sofort produktiv – das spart enorm bei Einschulung und Personalwechsel.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Funkbonieren', item: new URL(canonical, siteUrl).toString() },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={jsonLd}
>
  <HeroPhoto
    image="/images/orderlyze/checkout-counter.jpg"
    title="Funkbonieren"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    overlay="dark"
  />

  <section class="band band-soft">
    <SectionHeading title="Mehr Erfolg mit Funkbonieren" />
    <p class="intro-lead">
      Damit dein Unternehmen gut läuft, ist es wichtig, dass alles beim Bedienen der Gäste und in der Küche
      reibungslos funktioniert. Wenn alles schnell und einfach geht, sind die Gäste glücklicher und kommen
      gerne wieder. Eine Gastronomie, die gut läuft, spart Zeit und Geld und macht mehr Gewinn.
    </p>
  </section>

  <SplitCard
    background="white"
    image="/images/orderlyze/app-phone.png"
    imageSide="right"
    title="Was ist Funkbonieren?"
    body="Stift und Kellnerblock gehören der Vergangenheit an. Heute nimmst du die Bestellungen ganz einfach per Smartphone oder All-In-One Gerät (integrierter Drucker & Kartenzahlung) auf. Mit einem Fingertipp werden die Bestellungen des Tisches sofort bei der Bar und in der Küche gedruckt. So können viele Wege vermieden, Zeit gespart und der Umsatz gesteigert werden."
  />

  <SplitCard
    background="soft"
    image="/images/orderlyze/devices-small.jpg"
    imageSide="left"
    title="Unbegrenzt viele Geräte"
    body="Mit dem Orderlyze Gastronomie+ Paket kannst du mit so vielen Geräten arbeiten, wie du benötigst. Egal wie viele Standkassen, mobile Geräte für die KellnerInnen und Drucker du benötigst, du bezahlst keinen Aufpreis. Wo deine Bestellungen gedruckt werden, kannst du ganz individuell einrichten und organisieren."
  />

  <section class="band band-soft">
    <SectionHeading title="Arbeite genau so, wie du es brauchst" />
    <div class="device-row">
      <div class="device-pill">Standkasse 1</div>
      <div class="device-pill">Standkasse 2</div>
      <div class="device-pill">Kellner 1</div>
      <div class="device-pill">Kellner 2</div>
      <div class="device-pill">Kellner 3</div>
      <div class="device-pill highlight">Küchendrucker</div>
      <div class="device-pill highlight">Bardrucker</div>
    </div>
  </section>

  <section class="band band-white">
    <SectionHeading title="Das bringt dir Funkbonieren" />
    <div class="benefit-grid">
      {benefits.map((b) => (
        <article class="benefit-card">
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>
  </section>

  <SplitCard
    background="soft"
    image="/images/orderlyze/support.jpg"
    imageSide="right"
    title="Funkbonieren super schnell einrichten"
    body="Die Orderlyze App einfach auf dein Android oder iOS Gerät installieren, die Drucker einschalten und schon kannst du dir selbst einstellen, wohin welche Bestellungen gedruckt werden. So kannst du die Küchenkommunikation genau so aufbauen, wie es für dein Unternehmen am besten ist. Natürlich unterstützen wir dich bei der Einrichtung, und zwar kostenlos."
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
  />

  <BlueCta
    title={'Bringe dein Unternehmen mit Funkbonieren auf das nächste Level!'}
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(56px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
  }

  .band-soft {
    background: #f7f8fb;
  }

  .band-white {
    background: white;
  }

  .intro-lead {
    max-width: 760px;
    margin: 0 auto;
    color: var(--muted);
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .device-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 920px;
    margin: 0 auto;
  }

  .device-pill {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 22px;
    background: white;
    border: 2px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .device-pill.highlight {
    background: var(--accent);
    color: white;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .benefit-card {
    padding: 28px;
    background: var(--soft);
    border-radius: 14px;
  }

  .benefit-card h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: 1.2rem;
  }

  .benefit-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
