---
/**
 * /funkbonieren — Funkboniersystem für die Gastronomie
 * Inhalt: planning/content/pages/funkbonieren.md
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import Checklist from '../components/Checklist.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import Faq from '../components/Faq.astro';
import { EVENTS } from '../config/site';

import kueche from '../assets/screenshots/kommunikation-kueche-funkbonieren.png';
import sunmiV2 from '../assets/hardware/sunmi-v2-pro-mobiles-kassengeraet.png';

const meta = {
  title: 'Funkboniersystem für Gastronomie | Orderlyze',
  description:
    'Mobiles Funkboniersystem für Restaurants, Cafés und Bars: Bestellungen am Tisch aufnehmen und direkt an Küche oder Bar übermitteln.',
  canonical: 'https://www.orderlyze.com/funkbonieren',
};

const faqs = [
  {
    q: 'Was ist ein Funkboniersystem?',
    a: 'Ein Funkboniersystem übermittelt Bestellungen vom mobilen Gerät des Servicepersonals direkt an Kasse, Küche oder Bar. Die Bestellung muss dadurch nicht noch einmal vom Kellnerblock in die Kasse übertragen werden.',
  },
  {
    q: 'Welche Geräte kann ich zum mobilen Bonieren verwenden?',
    a: 'Orderlyze läuft auf Android- und iOS-Smartphones und Tablets. Zusätzlich können kompatible All-in-One-Geräte mit integriertem Drucker und Kartenleser eingesetzt werden.',
  },
  {
    q: 'Können Bestellungen gleichzeitig an Küche und Bar gesendet werden?',
    a: 'Ja. Du legst fest, an welchem Drucker eine Produktgruppe ausgegeben wird. Getränke können beispielsweise an der Bar und Speisen am Küchendrucker ankommen.',
  },
  {
    q: 'Ist ein Tischplan im Funkboniersystem enthalten?',
    a: 'Ja. Mit dem digitalen Tischplan ordnest du Bestellungen einem Tisch zu und behältst offene Rechnungen im Blick. Details findest du im <a href="https://hilfe.orderlyze.com/funktionen/tischplan/">Hilfe-Center zum Tischplan</a>.',
  },
  {
    q: 'Was kostet Funkbonieren mit Orderlyze?',
    a: 'Das Paket Gastronomie + kostet 75 € pro Monat exkl. MwSt. und enthält Küchenkommunikation sowie unbegrenzt viele Geräte. Einmalig fallen 199 € für die Aktivierung an; benötigte Hardware kommt je nach Ausstattung hinzu. Alle Details stehen auf der <a href="/preise">Preisseite</a>.',
  },
];

/* Funk-Netzwerk-Diagramm: Geräte der alten Seite */
const geraete = [
  { icon: 'devices', label: 'Standkasse 1' },
  { icon: 'devices', label: 'Standkasse 2' },
  { icon: 'phone', label: 'Kellner 1' },
  { icon: 'phone', label: 'Kellner 2' },
  { icon: 'phone', label: 'Kellner 3' },
  { icon: 'printer', label: 'Küchendrucker' },
  { icon: 'printer', label: 'Bardrucker' },
] as const;
---

<BaseLayout {...meta}>
  <!-- ── Kopf ── -->
  <section class="page-hero">
    <div class="container page-hero__inner reveal">
      <h1>Funkboniersystem für die Gastronomie</h1>
      <p class="page-hero__lead">
        Bestellungen <span class="mark">mobil am Tisch</span> aufnehmen
      </p>
      <p class="page-hero__text">
        Dein Service nimmt Bestellungen per Smartphone, Tablet oder All-in-One-Gerät auf. Orderlyze
        übermittelt sie direkt an die Kasse und an die zugewiesenen Drucker in Küche oder Bar.
      </p>
      <ul class="page-hero__benefits">
        <li><Icon name="phone" size={18} /> Mobil bonieren</li>
        <li><Icon name="printer" size={18} /> Küche &amp; Bar ansteuern</li>
        <li><Icon name="devices" size={18} /> Android &amp; iOS</li>
        <li><Icon name="receipt" size={18} /> Tischrechnungen verwalten</li>
      </ul>
      <Button href="/angebot" size="lg" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
    </div>
  </section>

  <!-- ── Was ist Funkbonieren ── -->
  <Section variant="paper">
    <FeatureSplit eyebrow="Grundlagen" title="Was ist Funkbonieren?" mark="Funkbonieren">
      <Fragment slot="text">
        <p>
          Beim Funkbonieren erfasst das Servicepersonal die Bestellung direkt am Tisch. Produkte,
          Mengen, Gänge und Hinweise werden digital gespeichert und ohne erneutes Abtippen an die
          zuständige Station übermittelt. Getränke landen am Bardrucker, Speisen in der Küche und
          die offene Rechnung bleibt dem richtigen Tisch zugeordnet.
        </p>
      </Fragment>
      <Fragment slot="actions">
        <Button href="/angebot" variant="secondary" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
      </Fragment>
      <DeviceMockup type="tablet">
        <video
          src="/videos/funkbonieren.mp4"
          muted
          loop
          playsinline
          autoplay
          preload="none"
          aria-label="Video: Funkbonieren mit Orderlyze in der Praxis"
        ></video>
      </DeviceMockup>
    </FeatureSplit>
  </Section>

  <!-- ── Paket & Kosten ── -->
  <Section variant="paper">
    <div class="preis-info reveal">
      <div>
        <p class="preis-info__eyebrow">Paket Gastronomie +</p>
        <h2>Funkbonieren ab 75 € pro Monat</h2>
        <p>
          Enthalten sind Küchenkommunikation, Tischplan, alle Orderlyze-Funktionen und unbegrenzt
          viele Geräte. Die Preise verstehen sich exkl. MwSt.; Aktivierung und benötigte Hardware
          werden separat berechnet.
        </p>
      </div>
      <Button href="/preise" variant="secondary">Alle Preise ansehen</Button>
    </div>
  </Section>

  <!-- ── Geräte-Netzwerk ── -->
  <Section variant="tint">
    <SectionHead
      eyebrow="Unbegrenzt viele Geräte"
      title="Arbeite genau so, wie du es brauchst"
      lead="Mit dem Orderlyze Gastronomie+ Paket kannst du mit so vielen Geräten arbeiten, wie du benötigst. Egal wie viele Standkassen, wie viele mobile Geräte für die KellnerInnen und wie viele Drucker du benötigst – du bezahlst keinen Aufpreis. Wo deine Bestellungen gedruckt werden, kannst du ganz individuell einrichten und organisieren. Genau so, wie du es dir vorstellst."
    />
    <div class="funk-netz reveal" role="img" aria-label="Funk-Netzwerk: Standkassen, Kellner-Geräte und Drucker kommunizieren kabellos miteinander">
      <div class="funk-netz__hub">
        <Icon name="wifi" size={36} />
        <span>Orderlyze<br />Funk</span>
      </div>
      {
        geraete.map((g, i) => (
          <div class="funk-netz__node" style={`--i:${i}`}>
            <Icon name={g.icon} size={24} />
            <span>{g.label}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ── Stats ── -->
  <Section variant="surface">
    <div class="stats">
      <article class="stat reveal">
        <p class="stat__nr"><Icon name="bolt" size={40} /></p>
        <h2 class="stat__title">Mehr Bestellungen direkt am Tisch aufnehmen</h2>
        <p class="stat__text">
          Bestellungen werden direkt während des Gesprächs erfasst und an die richtige Station
          geschickt. Das erspart den Zwischenschritt über einen handschriftlichen Kellnerblock und
          reduziert Rückfragen zwischen Service, Küche und Bar.
        </p>
      </article>
      <article class="stat reveal">
        <p class="stat__nr"><Icon name="star" size={40} /></p>
        <h2 class="stat__title">Bester Service für deine Gäste</h2>
        <p class="stat__text">
          Servicekräfte sehen offene Tische und Rechnungen auf ihrem Gerät. Ergänzungen und
          Sonderwünsche werden gemeinsam mit der Bestellung übertragen, damit Küche und Bar die
          benötigten Informationen direkt erhalten.
        </p>
      </article>
      <article class="stat reveal">
        <p class="stat__nr"><Icon name="clock" size={40} /></p>
        <h2 class="stat__title">Laufwege und manuelle Arbeit reduzieren</h2>
        <p class="stat__text">
          Weil Bestellungen vom Tisch aus übermittelt werden, entfallen zusätzliche Wege zur
          Standkasse. Runner können fertige Bestellungen ausgeben, während das Servicepersonal die
          nächsten Tische betreut.
        </p>
      </article>
    </div>
    <p class="stats__cta">
      <Button href="/angebot" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
    </p>
  </Section>

  <!-- ── Einrichtung ── -->
  <Section variant="paper">
    <FeatureSplit
      eyebrow="Einrichtung"
      title="Funkbonieren Schritt für Schritt einrichten"
      mark="Schritt für Schritt"
      reverse
    >
      <Fragment slot="text">
        <p>
          Die Orderlyze App ganz einfach auf dein Android- oder iOS-Gerät installieren, die Drucker
          einschalten und schon kannst du dir selbst einstellen, wohin welche Bestellungen gedruckt
          werden. So kannst du die Küchenkommunikation genau so aufbauen, wie es für dein
          Unternehmen am besten ist und wie du am effizientesten arbeiten kannst. Natürlich
          unterstützen wir dich bei der Einrichtung, und zwar kostenlos.
        </p>
      </Fragment>
      <Image
        src={kueche}
        alt="Bestellungen werden per Funk an die Küche gesendet"
        widths={[480, 760, 1100]} width={1100}
        sizes="(max-width: 860px) 92vw, 50vw"
      />
    </FeatureSplit>
  </Section>

  <Faq
    faqs={faqs}
    title="Häufige Fragen zum Funkboniersystem"
    mark="Funkboniersystem"
    variant="surface"
  />

  <CtaBanner
    title="Funkboniersystem passend zu deinem Betrieb zusammenstellen"
    mark="deinem Betrieb"
    buttonLabel="Angebot anfordern"
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--color-surface) 0%, #fff 100%);
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .page-hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    max-width: 52rem;
  }

  .page-hero h1 {
    font-size: var(--text-h1);
    margin-bottom: 0.25em;
  }

  .page-hero__lead {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-heading-dark);
    margin-bottom: 0.9rem;
  }

  .page-hero__text {
    color: var(--color-text-muted);
    max-width: 46rem;
    margin-inline: auto;
  }

  .page-hero__benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem 1.6rem;
    list-style: none;
    margin: 1.4rem 0 1.8rem;
    padding: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-navy);
  }

  .page-hero__benefits li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .page-hero__benefits :global(svg) {
    color: var(--color-brand);
  }

  .preis-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .preis-info h2 {
    margin-bottom: 0.4em;
  }

  .preis-info p:last-child {
    max-width: 48rem;
    margin-bottom: 0;
  }

  .preis-info__eyebrow {
    color: var(--color-brand);
    font-family: var(--font-heading);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  /* ── Funk-Netzwerk ── */
  .funk-netz {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.1rem;
    max-width: 52rem;
    margin-inline: auto;
    position: relative;
    padding: 1rem 0;
  }

  .funk-netz__hub {
    display: grid;
    place-items: center;
    gap: 0.3rem;
    width: 9.5rem;
    height: 9.5rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
    line-height: 1.25;
    box-shadow: 0 0 0 14px rgba(6, 89, 169, 0.25), 0 0 0 28px rgba(6, 89, 169, 0.1);
    margin: 1.6rem;
  }

  .funk-netz__node {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #fff;
    border: 1px dashed var(--color-heading);
    border-radius: var(--radius-pill);
    padding: 0.7rem 1.2rem;
    color: var(--color-heading-dark);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .funk-netz__node :global(svg) {
    color: var(--color-brand);
  }

  /* ── Stats ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 2vw, 2.2rem);
  }

  .stat {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 2rem 1.7rem;
  }

  .stat__nr {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent-deep);
    margin: 0 0 0.4rem;
    line-height: 1;
    display: flex;
    align-items: baseline;
  }

  .stat__nr span {
    font-size: 1.6rem;
  }

  .stat__nr :global(svg) {
    color: var(--color-accent-deep);
  }

  .stat__title {
    font-size: 1.15rem;
    margin-bottom: 0.5em;
  }

  .stat__text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .stats__cta {
    text-align: center;
    margin: 2.4rem 0 0;
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .preis-info {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
