---
/**
 * /funktionen — Funktionsübersicht
 * Inhalt: planning/content/pages/funktionen.md
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import Checklist from '../components/Checklist.astro';
import Icon from '../components/Icon.astro';
import ReceiptCard from '../components/ReceiptCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import Faq from '../components/Faq.astro';
import { EVENTS } from '../config/site';

import bezahlungTheke from '../assets/branchen/cafe-bezahlung-theke.jpg';
import verwaltungMac from '../assets/screenshots/verwaltung-dashboard-mac.png';

const meta = {
  title: 'Kassensystem-Funktionen im Überblick | Orderlyze',
  description:
    'Alle Funktionen des Orderlyze Kassensystems im Überblick: Rechnungen, Kartenzahlung, Verwaltung, Datenexporte, Funkbonieren, Tischplan und mehr.',
  canonical: 'https://www.orderlyze.com/funktionen',
};

const fuerGastro = [
  { icon: 'wifi', title: 'Funkbonieren', href: '/funkbonieren' },
  { icon: 'devices', title: 'Tischplan' },
  { icon: 'clock', title: 'Gängesystem' },
  { icon: 'printer', title: 'Bewirtungsbeleg' },
  { icon: 'phone', title: 'E-Beleg per QR-Code' },
  { icon: 'receipt', title: 'Rechnungen erstellen und bearbeiten' },
  { icon: 'card', title: 'Kartenzahlung und Kassenlade' },
  { icon: 'star', title: 'Gutscheine & Rabatte' },
  { icon: 'sync', title: 'Stornobuchungen' },
] as const;

const fuerDienstleistung = [
  { icon: 'receipt', title: 'Rechnungen erstellen und bearbeiten' },
  { icon: 'card', title: 'Kartenzahlung und Kassenlade' },
  { icon: 'phone', title: 'E-Beleg per QR-Code' },
  { icon: 'users', title: 'Kundenmanagement' },
  { icon: 'star', title: 'Gutscheine & Rabatte' },
  { icon: 'users', title: 'Mitarbeiterverwaltung' },
  { icon: 'settings', title: 'Verwaltung von Produkten & Leistungen' },
  { icon: 'export', title: 'Datenexporte für Steuerberater' },
] as const;

/* FAQ (FAQPage-Schema): typische Fragen vor der Kassensystem-Entscheidung */
const faqs = [
  {
    q: 'Welche Funktionen sind im Orderlyze Kassensystem enthalten?',
    a: 'Alle — in jedem Paket: Rechnungen erstellen und bearbeiten, Kartenzahlung, E-Beleg per QR-Code, Gutscheine & Rabatte, Stornobuchungen, Kunden- und Mitarbeiterverwaltung sowie Datenexporte für die Steuerberatung. Es gibt keine abgespeckten Einstiegspakete, die Pakete unterscheiden sich nur nach Branche. Details auf der <a href="/preise">Preisseite</a>.',
  },
  {
    q: 'Welche Gastro-Funktionen bietet Orderlyze?',
    a: 'Für die Gastronomie gibt es <a href="/funkbonieren">Funkbonieren</a> direkt am Tisch, Tischplan, Gängesystem, Bewirtungsbeleg und Küchenkommunikation (im Paket Gastronomie +) — Bestellungen werden mit einem Fingertipp an Bar und Küche gedruckt.',
  },
  {
    q: 'Kann ich mit Orderlyze Kartenzahlungen annehmen?',
    a: 'Ja. Das Kassensystem unterstützt <a href="/kartenzahlung">Kartenzahlung</a> mit EC, Maestro/V Pay, Mastercard und Visa sowie Apple Pay und kontaktloses Bezahlen per NFC.',
  },
  {
    q: 'Gibt es Berichte und Exporte für die Steuerberatung?',
    a: 'Ja: Tages-, Monats- und Jahresberichte, Produktberichte und Berichte nach Zahlungsart — inklusive <a href="/datenexport-steuerberater">Exporten für Buchhaltungsprogramme</a> wie DATEV, BMD und RZL.',
  },
  {
    q: 'Auf welchen Geräten läuft das Kassensystem?',
    a: 'Orderlyze ist ein App-Kassensystem für Android- und iOS-Smartphones und -Tablets. Die Verwaltung läuft zusätzlich im Browser (orderlyze web) — von jedem Gerät aus. Wie der Einstieg abläuft, zeigt <a href="/so-funktionierts">So funktioniert’s</a>.',
  },
  {
    q: 'Ist das Kassensystem finanzamtkonform?',
    a: 'Ja: <a href="/finanzamt-konform">RKSV-konform</a> in Österreich sowie KassenSichV- und TSE-konform in Deutschland — die Finanzamt-Signatur ist in jedem Paket enthalten.',
  },
];
---

<BaseLayout {...meta}>
  <!-- ── Für die Gastronomie ── -->
  <Section variant="paper">
    <SectionHead
      level={1}
      eyebrow="Für die Gastronomie"
      title="Funktionen für die Gastronomie"
      mark="Gastronomie"
      lead="Für den Gastro-Alltag gebaut — von Funkbonieren bis Tischplan."
    />
    <CardGrid columns={4}>
      {
        fuerGastro.map((f) => (
          <Card title={f.title} level={3} href={'href' in f ? f.href : undefined}>
            <Icon name={f.icon} slot="icon" size={28} />
          </Card>
        ))
      }
    </CardGrid>
  </Section>

  <!-- ── Für Dienstleister ── -->
  <Section variant="tint" size="sm">
    <SectionHead
      eyebrow="Für Dienstleister"
      title="Funktionen für Dienstleistung"
      mark="Dienstleistung"
      lead="Termin abgeschlossen, Beleg gedruckt oder als E-Beleg per QR-Code — so einfach kassierst du."
    />
    <CardGrid columns={4}>
      {
        fuerDienstleistung.map((f) => (
          <Card title={f.title} level={3}>
            <Icon name={f.icon} slot="icon" size={28} />
          </Card>
        ))
      }
    </CardGrid>
  </Section>

  <!-- ── Kartenzahlung ── -->
  <Section variant="paper">
    <FeatureSplit eyebrow="Kartenzahlung" title="Umsatz steigern. Mit Kartenzahlung." mark="Kartenzahlung">
      <Fragment slot="text">
        <p>
          Bist du bereits für jede Zahlungsmethode gerüstet? Immer mehr Kunden bevorzugen es,
          bargeldlos zu bezahlen, vor allem weil es bequem, schnell und sicher ist. Mit Orderlyze
          kannst du deinen KundInnen genau das bieten. Kartenzahlung ist bei uns wirklich einfach
          und ist schnell eingerichtet. Das hat auch für dich große Vorteile:
        </p>
        <Checklist items={['Zufriedene KundInnen', 'Mehr Umsatz', 'Mehr Zeit']} />
      </Fragment>
      <Fragment slot="actions">
        <Button href="/kartenzahlung" variant="secondary">Mehr erfahren</Button>
      </Fragment>
      <Image
        src={bezahlungTheke}
        alt="Kundin bezahlt bargeldlos mit Karte an der Theke"
        widths={[480, 760, 1100]} width={1100}
        sizes="(max-width: 860px) 92vw, 50vw"
        class="photo-rounded"
      />
    </FeatureSplit>
  </Section>

  <!-- ── Funkbonieren ── -->
  <Section variant="surface">
    <FeatureSplit
      eyebrow="Funkbonieren"
      title="So effizient wie noch nie. Gewinne Zeit und steigere deinen Umsatz."
      mark="effizient"
      reverse
    >
      <Fragment slot="text">
        <p>
          Bestellungen vom Tisch in die Küche oder zur Bar zu senden ist mit Orderlyze so einfach
          wie noch nie. Egal ob mit Smartphone oder All-in-One Gerät (integrierter Drucker +
          Kartenzahlung), mit der Orderlyze App können deine KellnerInnen super effizient arbeiten,
          ohne viel Einarbeitungszeit. Mit Funkbonieren holst du das Maximum aus deinem
          Unternehmen:
        </p>
        <Checklist
          items={[
            'Schneller und effizienter aufnehmen',
            'Höhere Kundenzufriedenheit',
            'Minimiert Fehler bei der Bestellaufnahme',
            'Geringere Wartezeiten',
            'Mehr Umsatz, mehr Zeit',
          ]}
        />
      </Fragment>
      <Fragment slot="actions">
        <Button href="/funkbonieren" variant="secondary">Mehr erfahren</Button>
      </Fragment>
      <DeviceMockup type="tablet">
        <video
          src="/videos/funkbonieren.mp4"
          muted
          loop
          playsinline
          autoplay
          preload="none"
          aria-label="Video: Funkbonieren mit Orderlyze"
        ></video>
      </DeviceMockup>
    </FeatureSplit>
  </Section>

  <!-- ── Verwaltung ── -->
  <Section variant="paper">
    <FeatureSplit
      eyebrow="Verwaltung"
      title="Einfach übersichtlich. Einfach praktisch. Einfach mehr Zeit. Mit orderlyze web."
      mark="orderlyze web"
    >
      <Fragment slot="text">
        <p>
          Von der Einrichtung über die Verwaltung bis zu den Auswertungen. orderlyze web
          erleichtert dir, dein Unternehmen zu verwalten und organisieren. Preisänderungen
          durchführen, Tages- und Monatsberichte erstellen sowie Statistiken &amp; Umsätze ansehen
          sind ab sofort kein Problem mehr.
        </p>
        <Checklist
          items={[
            'Super einfach und bequem von überall verwalten',
            'Einstellungen für deine Wünsche anpassen',
            'Exporte für SteuerberaterInnen mit nur wenigen Klicks',
            'Diverse Berichte und Statistiken',
          ]}
        />
      </Fragment>
      <Fragment slot="actions">
        <Button href="/verwaltung" variant="secondary">Mehr erfahren</Button>
      </Fragment>
      <Image
        src={verwaltungMac}
        alt="orderlyze web Verwaltung am Laptop"
        widths={[480, 760, 1100]} width={1100}
        sizes="(max-width: 860px) 92vw, 50vw"
      />
    </FeatureSplit>
  </Section>

  <!-- ── Konform-Statement ── -->
  <Section variant="accent" size="sm">
    <div class="konform-statement reveal">
      <h2>
        Spar dir deine Sorgen und Mühen. Mit Orderlyze bist du zu
        <strong>RKSV- und KassenSichV-konform</strong> und musst dich um nichts kümmern.
      </h2>
      <Button href="/angebot" size="lg" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
    </div>
  </Section>

  <!-- ── Testimonials ── -->
  <Section variant="paper">
    <SectionHead eyebrow="Kundenstimmen" title="Erfahrungen mit Orderlyze" mark="Orderlyze" />
    <div class="testimonials">
      <ReceiptCard tilt="left" class="reveal">
        <p class="receipt-mono">— Kundenstimme #001 —</p>
        <hr class="receipt-rule" />
        <blockquote class="testimonial-quote">
          Seit dem ich Orderlyze verwende, habe ich keine Probleme gehabt. Alles geht super einfach
          und ich kann alle meine Produkte unkompliziert bearbeiten. Einfach toll!
        </blockquote>
        <hr class="receipt-rule" />
        <p class="receipt-row">
          <strong>Carlo M.</strong>
          <span class="receipt-mono">Pizzachef</span>
        </p>
      </ReceiptCard>
      <ReceiptCard tilt="right" class="reveal">
        <p class="receipt-mono">— Kundenstimme #002 —</p>
        <hr class="receipt-rule" />
        <blockquote class="testimonial-quote">
          Orderlyze hat mir den Alltag wirklich sehr erleichtert. Ich gewinne sehr viel Zeit und
          keiner meiner MitarbeiterInnen hat Probleme bei der Bedienung. Außerdem ist die Hardware
          sehr günstig gewesen.
        </blockquote>
        <hr class="receipt-rule" />
        <p class="receipt-row">
          <strong>Helene S.</strong>
          <span class="receipt-mono">Kosmetikerin</span>
        </p>
      </ReceiptCard>
    </div>
    <p class="testimonials-cta">
      <Button href="/angebot" event={EVENTS.ctaAngebot}>Hol dir auch ein Angebot</Button>
    </p>
  </Section>

  <Faq
    faqs={faqs}
    title="Häufige Fragen zu den Funktionen"
    mark="Funktionen"
    variant="surface"
  />

  <CtaBanner title="Interessiert? Dann hol dir ein unverbindliches Angebot" mark="unverbindliches" />
</BaseLayout>

<style>
  .photo-rounded {
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-lg);
  }

  .konform-statement {
    display: grid;
    grid-template-columns: minmax(0, 8fr) auto;
    align-items: center;
    gap: 2rem;
  }

  .konform-statement h2 {
    font-size: clamp(1.3rem, 1.1rem + 1.2vw, 1.9rem);
    color: var(--color-navy);
    margin: 0;
    line-height: 1.35;
  }

  .testimonials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  .testimonial-quote {
    margin: 0;
    line-height: 1.7;
  }

  .testimonials-cta {
    text-align: center;
    margin: 2.6rem 0 0;
  }

  @media (max-width: 860px) {
    .konform-statement,
    .testimonials {
      grid-template-columns: 1fr;
    }
  }
</style>
