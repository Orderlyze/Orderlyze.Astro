---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import Testimonials from '../components/orderlyze/Testimonials.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { thermoRollen } from '../lib/thermorollen';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

const title = 'Thermorollen Shop | Orderlyze';
const description =
  'Hochwertige Thermorollen einfach und günstig bestellen. Phenolfrei, schnelle Lieferung nach Deutschland und Österreich.';
const canonical = '/thermorollen/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <HeroPhoto
    image="/images/orderlyze/checkout-counter.jpg"
    title={'Hochwertige Thermorollen einfach und günstig bestellen'}
    overlay="dark"
  />

  <section class="band band-soft">
    <div class="usp-row">
      <div class="usp">Gratis Lieferung nach DE & AT</div>
      <div class="usp">-10% Rabatt nur kurze Zeit</div>
      <div class="usp">Lieferzeit 1–3 Werktage</div>
    </div>
    <p class="intro-lead">
      Unsere Bonrollen garantieren nicht nur eine reibungslose und effiziente Transaktionsabwicklung,
      sondern setzen auch neue Maßstäbe in puncto Qualität und Zuverlässigkeit.
    </p>
  </section>

  <section class="band band-white">
    <div class="product-grid">
      {thermoRollen.map((p) => (
        <a class="product" href={withBasePath(`/product-page/${encodeURIComponent(p.slug)}/`)}>
          <div class="product-img">
            <svg viewBox="0 0 64 80" width="80" height="100" aria-hidden="true">
              <rect x="4" y="6" width="56" height="68" rx="6" ry="6" fill="#f3f4f6" stroke="#d1d5db" stroke-width="1.5" />
              <rect x="10" y="14" width="44" height="3" fill="#9ca3af" />
              <rect x="10" y="22" width="36" height="3" fill="#9ca3af" />
              <rect x="10" y="30" width="40" height="3" fill="#9ca3af" />
              <rect x="10" y="38" width="30" height="3" fill="#9ca3af" />
              <rect x="10" y="46" width="44" height="3" fill="#9ca3af" />
            </svg>
          </div>
          <h3>{p.name}</h3>
          <p>{p.pack}</p>
          <div class="price">
            {p.oldPrice && <span class="old">{p.oldPrice}</span>}
            <strong>{p.price}</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Testimonials
    title="Was Kunden über unsere Thermorollen sagen"
    items={[
      {
        name: 'Marlene R.',
        role: 'Cafe-Inhaberin',
        copy: 'Sehr einfache Bestellung und hab die Lieferung in 2 Tagen erhalten. Kaufe gerne wieder!',
        image: '/images/orderlyze/customer-helene.jpg',
      },
      {
        name: 'Thomas M.',
        role: 'Restaurantleiter',
        copy: 'Thermorollen haben eine gute Qualität und wurden schnell geliefert, kann ich nur empfehlen.',
        image: '/images/orderlyze/customer-carlo.jpg',
      },
    ]}
  />

  <BlueCta
    title="Direkt zum Kassensystem-Angebot?"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }
  .band-soft { background: #fafafa; }
  .band-white { background: white; }

  .usp-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    max-width: 880px;
    margin: 0 auto 22px;
  }

  .usp {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 14px 16px;
    text-align: center;
    color: var(--accent);
    font-weight: 800;
    font-size: 0.92rem;
  }

  .intro-lead {
    max-width: 760px;
    margin: 0 auto;
    color: #4b5563;
    text-align: center;
    font-size: 1rem;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .product {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 140ms, box-shadow 140ms;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .product:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 28px rgb(6 89 169 / 12%);
  }

  .product-img {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    border-radius: 4px;
    padding: 18px;
    margin-bottom: 12px;
    width: 100%;
  }

  .product h3 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 800;
  }

  .product p {
    margin: 0 0 12px;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .price .old {
    color: #9ca3af;
    text-decoration: line-through;
    font-size: 0.85rem;
  }

  .price strong {
    color: var(--accent);
    font-weight: 900;
    font-size: 1.2rem;
  }

  @media (max-width: 900px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .usp-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .product-grid { grid-template-columns: 1fr; }
  }
</style>
