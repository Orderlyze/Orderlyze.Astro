---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Testimonials from '../../components/orderlyze/Testimonials.astro';
import { absoluteSiteUrl, withBasePath } from '../../lib/url';
import { thermoRollen } from '../../lib/thermorollen';

export function getStaticPaths() {
  return thermoRollen.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const siteUrl = absoluteSiteUrl(Astro.site);
const canonical = `/product-page/${encodeURIComponent(product.slug)}/`;
---

<BaseLayout
  title={`${product.name} | Orderlyze`}
  description={product.description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: product.price.replace('€', '').replace(',', '.').trim(),
      availability: 'https://schema.org/InStock',
      url: new URL(canonical, siteUrl).toString(),
    },
  }}
>
  <section class="usp-strip">
    <span>★ gratis Lieferung nach Deutschland und Österreich</span>
    <span>★ nur für kurze Zeit: -10% Rabatt</span>
    <span>★ Lieferzeit: 1–3 Werktage</span>
  </section>

  <section class="product-band">
    <div class="product-detail">
      <div class="product-visual">
        <svg viewBox="0 0 96 96" width="280" height="280" aria-hidden="true">
          <defs>
            <radialGradient id="roll" cx="50%" cy="40%" r="50%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="70%" stop-color="#e5e7eb" />
              <stop offset="100%" stop-color="#9ca3af" />
            </radialGradient>
          </defs>
          <ellipse cx="32" cy="34" rx="22" ry="22" fill="url(#roll)" />
          <ellipse cx="60" cy="50" rx="22" ry="22" fill="url(#roll)" />
          <ellipse cx="40" cy="64" rx="22" ry="22" fill="url(#roll)" />
          <circle cx="32" cy="34" r="6" fill="#e5e7eb" />
          <circle cx="60" cy="50" r="6" fill="#e5e7eb" />
          <circle cx="40" cy="64" r="6" fill="#e5e7eb" />
        </svg>
        <p class="thumb-caption">Thermorollen mit Maße 80x80x12 und gängige Druckerlayouts für Kassensystem<br/>100% phenolfrei</p>
      </div>
      <div class="product-info">
        <a class="back" href={withBasePath('/thermorollen/')}>← zum Shop</a>
        <h1>{product.name}</h1>
        <div class="price-row">
          {product.oldPrice && <span class="old">€&nbsp;{product.oldPrice.replace('€','').trim()}</span>}
          <strong>€&nbsp;{product.price.replace('€','').trim()}</strong>
        </div>
        <p class="incl">inklusive Lieferkosten</p>
        <div class="qty-row">
          <label>Anzahl:</label>
          <div class="qty-control">
            <button type="button" aria-label="-">−</button>
            <input type="number" min="1" value="1" />
            <button type="button" aria-label="+">+</button>
          </div>
        </div>
        <a class="cart-cta" href="mailto:office@orderlyze.com?subject=Bestellung+Thermorollen">In den Warenkorb</a>
        <a class="buy-cta" href="mailto:office@orderlyze.com?subject=Sofortbestellung+Thermorollen">Jetzt bestellen</a>

        <details class="specs">
          <summary>PRODUKTINFO</summary>
          <ul>
            <li><strong>Rollendurchm.:</strong> 80 mm</li>
            <li><strong>Rollenbreite:</strong> 80 mm</li>
            <li><strong>Hülsendurchm.:</strong> 12 mm</li>
            <li><strong>Papiergewicht:</strong> 50 g/m² oder 60 g/m²</li>
            <li><strong>Verpackungseinheit:</strong> {product.pack}</li>
            <li><strong>Qualität:</strong> Mittlere dynamische Sensitivität</li>
            <li><strong>Lagerung:</strong> Hergestellt ohne Verwendung von Phenolen</li>
            <li><strong>Haltbarkeit:</strong> bei korrekter Lagerung 10 Jahre</li>
            <li><strong>Durchmesser:</strong> 75 Millimeter</li>
          </ul>
        </details>
      </div>
    </div>
  </section>

  <Testimonials
    title=""
    items={[
      {
        name: 'Marlene R.',
        role: 'Cafe-Inhaberin',
        copy: 'Sehr einfache Bestellung und hab die Lieferung in 2 Tagen erhalten. Kaufe gerne wieder!',
        image: '/images/orderlyze/customer-helene.jpg',
      },
      {
        name: 'Thomas M.',
        role: 'Restaurantleiter',
        copy: 'Thermorollen haben eine gute Qualität und wurden schnell geliefert.',
        image: '/images/orderlyze/customer-carlo.jpg',
      },
    ]}
  />
</BaseLayout>

<style>
  .usp-strip {
    background: var(--accent);
    color: white;
    padding: 10px 20px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .product-band {
    padding: clamp(32px, 5vw, 64px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .product-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    max-width: 1080px;
    margin: 0 auto;
  }

  .product-visual {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 32px;
    display: grid;
    place-items: center;
  }

  .thumb-caption {
    margin: 12px 0 0;
    color: #6b7280;
    font-size: 0.82rem;
    text-align: center;
    line-height: 1.4;
  }

  .product-info .back {
    color: var(--accent);
    font-weight: 800;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .product-info h1 {
    margin: 8px 0 12px;
    color: var(--ink);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    line-height: 1.2;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 4px;
  }

  .price-row .old { color: #9ca3af; text-decoration: line-through; font-size: 1rem; }
  .price-row strong { color: #16a34a; font-size: 1.8rem; font-weight: 900; }

  .incl {
    margin: 0 0 22px;
    color: #6b7280;
    font-size: 0.82rem;
  }

  .qty-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
  }

  .qty-row label {
    font-weight: 700;
    color: var(--ink);
    font-size: 0.9rem;
  }

  .qty-control {
    display: inline-flex;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    overflow: hidden;
  }

  .qty-control button {
    border: 0;
    background: #f3f4f6;
    width: 32px;
    height: 36px;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .qty-control input {
    border: 0;
    width: 50px;
    text-align: center;
    font: inherit;
    font-weight: 700;
  }

  .cart-cta,
  .buy-cta {
    display: block;
    width: 100%;
    padding: 12px 18px;
    border-radius: 4px;
    text-align: center;
    font-weight: 800;
    text-decoration: none;
    font-size: 0.95rem;
    margin: 0 0 10px;
  }

  .cart-cta {
    background: #16a34a;
    color: white;
  }

  .cart-cta:hover { background: #15803d; }

  .buy-cta {
    background: white;
    color: var(--ink);
    border: 1px solid #111827;
  }

  .buy-cta:hover {
    background: #111827;
    color: white;
  }

  .specs {
    margin-top: 18px;
    border-top: 1px solid #e5e7eb;
    padding-top: 16px;
  }

  .specs summary {
    cursor: pointer;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: 0.04em;
    font-size: 0.85rem;
  }

  .specs ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    color: #4b5563;
    font-size: 0.9rem;
  }

  .specs li strong { color: var(--ink); }

  @media (max-width: 800px) {
    .product-detail { grid-template-columns: 1fr; }
    .usp-strip { gap: 14px; font-size: 0.78rem; }
  }
</style>
