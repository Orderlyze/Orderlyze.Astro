---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlueCta from '../../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl, withBasePath } from '../../lib/url';
import { thermoRollen } from '../../lib/thermorollen';

export function getStaticPaths() {
  return thermoRollen.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const siteUrl = absoluteSiteUrl(Astro.site);
const canonical = `/product-page/${encodeURIComponent(product.slug)}/`;
---

<BaseLayout
  title={`${product.name} | Orderlyze`}
  description={product.description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: product.price.replace('€', '').replace(',', '.').trim(),
      availability: 'https://schema.org/InStock',
      url: new URL(canonical, siteUrl).toString(),
    },
  }}
>
  <section class="product-band">
    <div class="product-detail">
      <div class="product-visual">
        <svg viewBox="0 0 240 320" width="240" height="320" aria-hidden="true">
          <rect x="18" y="20" width="204" height="280" rx="12" ry="12" fill="#f3f4f6" stroke="#d1d5db" stroke-width="2" />
          <g transform="translate(36 50)">
            <rect width="168" height="6" fill="#9ca3af" />
            <rect y="20" width="120" height="6" fill="#9ca3af" />
            <rect y="40" width="140" height="6" fill="#9ca3af" />
            <rect y="60" width="100" height="6" fill="#9ca3af" />
            <rect y="80" width="160" height="6" fill="#9ca3af" />
            <rect y="100" width="130" height="6" fill="#9ca3af" />
            <rect y="120" width="150" height="6" fill="#9ca3af" />
          </g>
        </svg>
      </div>
      <div class="product-info">
        <a class="back" href={withBasePath('/thermorollen/')}>← zum Shop</a>
        <h1>{product.name}</h1>
        <p class="pack">{product.pack}</p>
        <div class="price">
          {product.oldPrice && <span class="old">{product.oldPrice}</span>}
          <strong>{product.price}</strong>
        </div>
        <p class="desc">{product.description}</p>
        <ul class="features">
          <li>Phenolfrei, BPA-frei</li>
          <li>Hochwertige Druckqualität</li>
          <li>Lieferzeit 1–3 Werktage</li>
          <li>Gratis Lieferung in DE & AT</li>
        </ul>
        <a class="buy-cta" href="mailto:office@orderlyze.com?subject=Bestellung+Thermorollen">Jetzt bestellen</a>
      </div>
    </div>
  </section>

  <BlueCta
    title="Du brauchst auch ein Kassensystem?"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .product-band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .product-detail {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .product-visual {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-info .back {
    color: var(--accent);
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .product-info h1 {
    margin: 10px 0 6px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.15;
  }

  .pack {
    color: #6b7280;
    margin: 0 0 14px;
    font-size: 0.92rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 18px;
  }

  .price .old { color: #9ca3af; text-decoration: line-through; font-size: 1rem; }
  .price strong { color: var(--accent); font-size: 2rem; font-weight: 900; }

  .desc {
    margin: 0 0 18px;
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.55;
  }

  .features {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: grid;
    gap: 6px;
    color: var(--ink);
  }

  .features li {
    padding-left: 22px;
    position: relative;
    font-size: 0.95rem;
  }

  .features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 900;
  }

  .buy-cta {
    display: inline-flex;
    align-items: center;
    height: 50px;
    padding: 0 32px;
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    font-size: 0.9rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .buy-cta:hover { background: #044d8c; }

  @media (max-width: 800px) {
    .product-detail { grid-template-columns: 1fr; }
  }
</style>
