---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import SectionHeading from '../components/orderlyze/SectionHeading.astro';
import SplitCard from '../components/orderlyze/SplitCard.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Technische Sicherheitseinrichtung (TSE) | Orderlyze';
const description =
  'Was ist eine TSE für Registrierkassen, wer ist verpflichtet und wie hilft dir Orderlyze 100% konform zu bleiben?';
const canonical = '/technische-sicherheitseinrichtung/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/konform-2.png"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <HeroPhoto
    image="/images/orderlyze/konform-2.png"
    title="Technische Sicherheitseinrichtung"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    overlay="dark"
  />

  <section class="band band-soft notice">
    <div class="notice-card">
      Achtung: die letzte TSE-Frist endet am 31.12.2022!
    </div>
  </section>

  <SplitCard
    background="white"
    variant="plain"
    title="Was ist die TSE für Registrierkassen?"
    body="TSE steht für Technische Sicherheitseinrichtung und ist eine technische Schutzmaßnahme vor Manipulationen an digitalen Aufzeichnungen. Dadurch soll verhindert werden, dass Aufzeichnungen, die du mit deinem Kassensystem tätigst, nachträglich geändert oder gelöscht werden. Die Verpflichtung wurde in der Kassensicherungsverordnung (KassenSichV), welche seit 2020 in Deutschland gilt, festgelegt."
  />

  <SplitCard
    background="soft"
    variant="plain"
    title="Wer ist verpflichtet, eine TSE zu haben?"
    body="Ab dem 01. Januar 2023 müssen elektronische Registrierkassen mit einer zertifizierten Sicherheitseinrichtung ausgestattet sein. Das betrifft alle Branchen, auch die Gastronomie. Wenn deine Kasse zwischen dem 25. November 2010 und dem 01. Januar 2020 angeschafft wurde und der GoBD entspricht oder nicht umgerüstet werden kann, musst du ein neues Kassensystem erwerben."
    bullets={[
      'Alle elektronischen Kassensysteme müssen eine TSE aufweisen',
      'Ab 01.01.2023 keine Ausnahmen mehr',
      'Auch Gastronomie ist verpflichtet',
    ]}
  />

  <SplitCard
    background="white"
    image="/images/orderlyze/support.jpg"
    imageSide="right"
    title="Wir bieten dir alles, was du brauchst"
    body="Wenn man deine aktuelle Kasse nicht aufrüsten kann, empfehlen wir den Umstieg auf Orderlyze. Mit uns bist du zu 100% Finanzamt und KassenSichV konform. Über die TSE Pflicht brauchst du dir keine Sorgen machen. Hol dir ein kostenloses Angebot oder buche dir ein kostenloses Beratungsgespräch."
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
  />

  <BlueCta
    title="Bereit für den Umstieg auf TSE-konformes Kassieren?"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }
  .band-soft { background: #fafafa; }

  .notice { padding-top: 24px; padding-bottom: 0; }

  .notice-card {
    max-width: 760px;
    margin: 0 auto;
    background: #fff7ed;
    border: 1px solid #fb923c;
    border-radius: 4px;
    padding: 14px 22px;
    color: #9a3412;
    font-weight: 800;
    text-align: center;
  }
</style>
