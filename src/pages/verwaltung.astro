---
/**
 * /verwaltung — orderlyze web Verwaltung
 * Inhalt: planning/content/pages/verwaltung.md
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import Checklist from '../components/Checklist.astro';
import CtaBanner from '../components/CtaBanner.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import { EVENTS } from '../config/site';

import verwaltungMac from '../assets/screenshots/verwaltung-dashboard-mac.png';
import mitarbeiter from '../assets/screenshots/mitarbeiterverwaltung.png';
import umsaetze from '../assets/screenshots/umsaetze-dashboard.png';
import monatsbericht from '../assets/screenshots/monatsbericht.png';

const meta = {
  title: 'Kassen-Verwaltung: Umsätze & Berichte | Orderlyze',
  description:
    'Mit orderlyze web verwaltest du dein Unternehmen von überall: Produkte, Mitarbeiter, Statistiken und Datenexporte für den Steuerberater — einfach und übersichtlich.',
  canonical: 'https://www.orderlyze.com/verwaltung',
};
---

<BaseLayout {...meta}>
  <!-- ── Kopf ── -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__text reveal">
        <h1>Verwaltung</h1>
        <p class="page-hero__lead">
          Mit <span class="mark">orderlyze web</span> kannst du dein Unternehmen einfach und von
          überall managen und organisieren. Sei es Produkte verwalten, wichtige
          (Umsatz-)Statistiken ansehen oder Datenexporte für deinen Steuerberater herunterladen.
        </p>
        <Button href="/angebot" size="lg" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
      </div>
      <div class="page-hero__media reveal">
        <Image
          src={verwaltungMac}
          alt="orderlyze web Verwaltungs-Dashboard am Laptop"
          widths={[480, 760, 1200]}
          sizes="(max-width: 860px) 92vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ── Überblick ── -->
  <Section variant="paper">
    <FeatureSplit eyebrow="Voller Überblick" title="Hole das Beste aus deinem Unternehmen" mark="Beste">
      <Fragment slot="text">
        <p>
          Mit orderlyze web hast du dein Unternehmen immer voll im Griff, und das von überall aus.
          Egal ob mit Smartphone, Tablet oder PC, du hast in wenigen Sekunden Zugriff auf alle
          deine Unternehmensdaten, kannst diese bearbeiten und dir ansehen, was in deinem
          Unternehmen vor sich geht. Analysiere deine Umsätze und sieh dir an, welche Produkte sich
          besonders gut verkaufen. Das hilft dir dabei, die richtigen Entscheidungen zu treffen und
          so deinen Umsatz zu steigern und deine KundInnen zufrieden zu stellen.
        </p>
        <Checklist
          items={[
            'Einfache Verwaltung von überall',
            'Mit wenigen Klicks wichtige Änderungen vornehmen',
            'Wichtige Berichte und Statistiken',
            'Übersichtlicher Einblick in dein Unternehmen',
          ]}
        />
      </Fragment>
      <DeviceMockup type="browser">
        <Image
          src={umsaetze}
          alt="Umsatz-Statistiken im orderlyze web Dashboard"
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </DeviceMockup>
    </FeatureSplit>
  </Section>

  <!-- ── Mitarbeiter ── -->
  <Section variant="surface">
    <FeatureSplit eyebrow="Mitarbeiter" title="Mehr Erfolg mit deinen Mitarbeitern" mark="Erfolg" reverse>
      <Fragment slot="text">
        <p>
          Mit Orderlyze kannst du genau festlegen, was deine Mitarbeiter mit dem Kassensystem
          machen dürfen. So kannst du zum Beispiel festlegen, dass diese keine Produkte stornieren
          oder Umsatzstatistiken einsehen dürfen. Außerdem kannst du dir ansehen, wieviel Umsatz
          deine Mitarbeiter in einem bestimmten Zeitraum erwirtschaften. Dadurch kannst du
          erkennen, in welchen Bereichen du deinen Umsatz noch steigern kannst.
        </p>
      </Fragment>
      <Fragment slot="actions">
        <Button href="/angebot" variant="secondary" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
      </Fragment>
      <DeviceMockup type="browser">
        <Image
          src={mitarbeiter}
          alt="Mitarbeiterverwaltung mit Berechtigungen in orderlyze web"
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </DeviceMockup>
    </FeatureSplit>
  </Section>

  <!-- ── Produkt-Insights ── -->
  <Section variant="paper">
    <FeatureSplit eyebrow="Statistiken" title="Welche Produkte lieben deine Kunden?" mark="lieben">
      <Fragment slot="text">
        <p>
          orderlyze web verrät dir, welche Produkte und Dienstleistungen deine KundInnen am
          liebsten in Anspruch nehmen. Anhand dieser Einsichten kannst du zum Beispiel entscheiden,
          welche Preise für welche Produkte am wirtschaftlichsten sind und welche neuen
          Möglichkeiten sich daraus ergeben können.
        </p>
      </Fragment>
      <Fragment slot="actions">
        <Button href="/angebot" variant="secondary" event={EVENTS.ctaAngebot}>Angebot anfordern</Button>
      </Fragment>
      <DeviceMockup type="browser">
        <Image
          src={monatsbericht}
          alt="Produktberichte und Auswertungen in orderlyze web"
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </DeviceMockup>
    </FeatureSplit>
  </Section>

  <!-- ── Steuerberater ── -->
  <Section variant="tint" size="sm">
    <div class="stb reveal">
      <div>
        <h2>Berichte für den Steuerberater? <span class="stb__accent">Kein Problem!</span></h2>
        <p>
          Mit orderlyze web hast du alle notwendigen Berichte für deinen Steuerberater
          griffbereit. So kannst du Tages-, Monats- und Jahresberichte in wenigen Sekunden
          herunterladen und versenden. Außerdem stehen dir Datenexporte für diverse
          Buchhaltungsprogramme zur Verfügung (DATEV, BMD, RZL).
        </p>
      </div>
      <Button href="/datenexport-steuerberater" variant="secondary">Mehr zum Datenexport</Button>
    </div>
  </Section>

  <CtaBanner
    title="Alles im Blick, alles im Griff. Hol dir jetzt ein unverbindliches Angebot!"
    mark="unverbindliches"
    buttonLabel="Angebot anfordern"
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--color-surface) 0%, #fff 100%);
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 10fr) minmax(0, 10fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .page-hero h1 {
    font-size: var(--text-h1);
    margin-bottom: 0.35em;
  }

  .page-hero__lead {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    margin-bottom: 1.8rem;
  }

  .stb {
    display: grid;
    grid-template-columns: minmax(0, 8fr) auto;
    gap: 2rem;
    align-items: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .stb h2 {
    margin-bottom: 0.5em;
  }

  .stb__accent {
    color: var(--color-brand);
  }

  .stb p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .page-hero__inner,
    .stb {
      grid-template-columns: 1fr;
    }
  }
</style>
