---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import Testimonials from '../components/orderlyze/Testimonials.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Testen | Orderlyze';
const description =
  '30 Tage kostenlos das Orderlyze Kassensystem testen. Formular ausfüllen und schon kann es losgehen.';
const canonical = '/testen/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/home-hero-person.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <HeroPhoto
    image="/images/orderlyze/home-hero-person.jpg"
    title="Kontaktiere uns und teste die ganze App kostenlos"
    overlay="dark"
  />

  <section class="form-band">
    <div class="trust-row">
      <div class="trust-badge"><strong>RKSV</strong><span>100% KONFORM</span></div>
      <div class="trust-badge"><strong>KassenSichV</strong><span>100% KONFORM</span></div>
      <div class="trust-badge"><strong>Daten Sicherheit</strong><span>Hosted in EU</span></div>
    </div>
    <div class="form-card">
      <h2>30 Tage kostenlos Testen</h2>
      <p class="form-sub">Formular ausfüllen, und schon kann es losgehen.</p>
      <form action="mailto:office@orderlyze.com?subject=Kostenlos+Testen" method="post" enctype="text/plain">
        <input type="text" name="Name" placeholder="Dein Name *" required />
        <input type="email" name="E-Mail" placeholder="Deine E-Mail Adresse *" required />
        <select name="Branche" required>
          <option value="">Deine Branche *</option>
          <option>Restaurant</option>
          <option>Cafe</option>
          <option>Bar</option>
          <option>Friseur</option>
          <option>Beauty</option>
          <option>Sonstige</option>
        </select>
        <select name="Mitarbeiter">
          <option value="">Anzahl MitarbeiterInnen</option>
          <option>1–3</option>
          <option>4–10</option>
          <option>11+</option>
        </select>
        <p class="advisor-note">Kostenlose Beratung durch einen Experten</p>
        <input type="tel" name="Telefon" placeholder="Deine Telefonnummer" />
        <button type="submit">Kostenlos Testen</button>
        <p class="legal">Kostenlos und Unverbindlich.</p>
      </form>
    </div>
  </section>

  <Testimonials
    title="Sieh dir an, was sie zu sagen haben"
    items={[
      {
        name: 'Verena S.',
        role: 'Salonbesitzerin',
        copy: 'Orderlyze hat mir den Alltag wirklich sehr erleichtert. Ich gewinne sehr viel Zeit und keiner meiner MitarbeiterInnen hat Probleme bei der Bedienung. Außerdem ist die Hardware sehr günstig gewesen.',
        image: '/images/orderlyze/customer-helene.jpg',
      },
    ]}
  />
</BaseLayout>

<style>
  .form-band {
    padding: clamp(32px, 5vw, 64px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .trust-row {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin: 0 auto 28px;
    flex-wrap: wrap;
  }

  .trust-badge {
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 8px 14px;
    text-align: center;
    min-width: 80px;
  }

  .trust-badge strong {
    display: block;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .trust-badge span {
    display: block;
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 800;
    margin-top: 2px;
    letter-spacing: 0.04em;
  }

  .form-card {
    max-width: 520px;
    margin: 0 auto;
    background: white;
    border: 2px solid #c8def4;
    border-radius: 4px;
    padding: clamp(28px, 4vw, 44px);
    text-align: center;
  }

  .form-card h2 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .form-sub {
    margin: 0 0 22px;
    color: #6b7280;
    font-size: 0.92rem;
  }

  form {
    display: grid;
    gap: 12px;
    text-align: left;
  }

  form input,
  form select {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
    background: white;
    font-size: 0.95rem;
  }

  form input:focus,
  form select:focus {
    border-color: var(--accent);
    outline: 2px solid rgb(6 89 169 / 18%);
  }

  .advisor-note {
    margin: 6px 0;
    padding: 10px 14px;
    background: var(--accent);
    color: white;
    border-radius: 4px;
    font-size: 0.92rem;
    font-weight: 700;
    text-align: center;
  }

  form button {
    height: 48px;
    border: 0;
    border-radius: 4px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
    margin-top: 6px;
  }

  form button:hover { background: #044d8c; }

  .legal {
    margin: 6px 0 0;
    color: #6b7280;
    font-size: 0.78rem;
    text-align: center;
  }
</style>
