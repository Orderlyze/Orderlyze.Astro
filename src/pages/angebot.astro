---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Angebot anfordern | Orderlyze';
const description =
  'Hol dir ein kostenloses, unverbindliches Angebot für das Orderlyze Kassensystem. Wir kontaktieren dich innerhalb von 24 Stunden.';
const canonical = '/angebot/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <HeroPhoto
    image="/images/orderlyze/checkout-counter.jpg"
    title="Das Nr. 1 Kassensystem"
    cta={{ label: 'kostenlos und unverbindlich', href: '#angebot-form' }}
    overlay="dark"
  />

  <section class="band band-soft intro-band">
    <p class="intro-lead">
      Langsame Kassensysteme und veraltete Geräte waren gestern. Heute gibt es dafür eine App für alle
      Android und iOS Geräte. Mit allen Funktionen, die du brauchst. Schnell und einfach individuell
      eingerichtet.
    </p>
    <div class="usp-row">
      <article class="usp">
        <svg viewBox="0 0 32 32" width="36" height="36"><path fill="currentColor" d="M9 4h14a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm7 22a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM9 6v16h14V6H9z" /></svg>
        <h3>Funkbonieren</h3>
      </article>
      <article class="usp">
        <svg viewBox="0 0 32 32" width="36" height="36"><path fill="currentColor" d="M3 9h26v4H3zm0 6h26v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM4 5h24a1 1 0 0 1 1 1v1H3V6a1 1 0 0 1 1-1zm3 14h10v3H7z" /></svg>
        <h3>Kartenzahlung</h3>
      </article>
      <article class="usp">
        <svg viewBox="0 0 32 32" width="36" height="36"><path fill="currentColor" d="M16 3 5 7v8c0 7 4.5 12 11 14 6.5-2 11-7 11-14V7L16 3zm5.7 9.4-7.4 7.4-3.6-3.6 1.4-1.4 2.2 2.2 6-6 1.4 1.4z" /></svg>
        <h3>100% konform</h3>
      </article>
    </div>
  </section>

  <section id="angebot-form" class="band band-white form-band">
    <div class="form-wrap">
      <h2>Angebot anfordern</h2>
      <p class="form-lead">Kostenlos und unverbindlich. Wir melden uns innerhalb von 24 Stunden bei dir.</p>
      <form class="offer-form" action="mailto:office@orderlyze.com" method="post" enctype="text/plain">
        <label>
          Name *
          <input type="text" name="Name" required />
        </label>
        <label>
          E-Mail *
          <input type="email" name="E-Mail" required />
        </label>
        <label>
          Telefon
          <input type="tel" name="Telefon" />
        </label>
        <label>
          Branche *
          <select name="Branche" required>
            <option value="">Bitte wählen</option>
            <option>Restaurant</option>
            <option>Cafe</option>
            <option>Bar</option>
            <option>Friseur</option>
            <option>Beauty</option>
            <option>Sonstige Dienstleistung</option>
          </select>
        </label>
        <label class="full">
          Nachricht
          <textarea name="Nachricht" rows="4" placeholder="Wie können wir dir helfen?"></textarea>
        </label>
        <button type="submit">Jetzt Angebot anfordern</button>
        <p class="legal">
          Mit dem Absenden stimmst du unserer <a href="/Orderlyze.Astro/datenschutzerklaerung/">Datenschutzerklärung</a> zu.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }
  .band-soft { background: #fafafa; }
  .band-white { background: white; }

  .intro-lead {
    max-width: 760px;
    margin: 0 auto 28px;
    color: #4b5563;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .usp-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-width: 880px;
    margin: 0 auto;
  }

  .usp {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 22px 18px;
    text-align: center;
    color: var(--accent);
  }

  .usp h3 {
    margin: 10px 0 0;
    color: var(--ink);
    font-size: 1.05rem;
  }

  .form-wrap {
    max-width: 760px;
    margin: 0 auto;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: clamp(24px, 4vw, 40px);
  }

  .form-wrap h2 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    text-align: center;
  }

  .form-lead {
    margin: 0 0 22px;
    color: #4b5563;
    text-align: center;
    font-size: 0.96rem;
  }

  .offer-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
  }

  .offer-form label {
    display: grid;
    gap: 6px;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .offer-form label.full { grid-column: span 2; }

  .offer-form input,
  .offer-form select,
  .offer-form textarea {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 10px 12px;
    font: inherit;
    color: var(--ink);
    background: white;
    font-weight: 400;
  }

  .offer-form input:focus,
  .offer-form select:focus,
  .offer-form textarea:focus {
    border-color: var(--accent);
    outline: 2px solid rgb(6 89 169 / 18%);
  }

  .offer-form button {
    grid-column: span 2;
    margin-top: 8px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .offer-form button:hover { background: #044d8c; }

  .legal {
    grid-column: span 2;
    margin: 4px 0 0;
    color: #6b7280;
    font-size: 0.78rem;
    text-align: center;
  }

  .legal a { color: var(--accent); }

  @media (max-width: 640px) {
    .usp-row { grid-template-columns: 1fr; }
    .offer-form { grid-template-columns: 1fr; }
    .offer-form label.full { grid-column: span 1; }
    .offer-form button { grid-column: span 1; }
    .legal { grid-column: span 1; }
  }
</style>
