---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

const title = 'Angebot anfordern | Orderlyze';
const description =
  'Hol dir ein kostenloses, unverbindliches Angebot für das Orderlyze Kassensystem. Wir kontaktieren dich innerhalb von 24 Stunden.';
const canonical = '/angebot/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <section class="hero-card-band">
    <p class="hero-eyebrow">kostenlos und unverbindlich</p>
    <div class="hero-card">
      <h1>Das Nr. 1 Kassensystem</h1>
      <p class="hero-desc">
        Langsame Kassensysteme und veraltete Geräte waren gestern. Heute gibt es dafür eine App für alle
        Android und iOS Geräte. Mit allen Funktionen, die du brauchst. Schnell und einfach individuell
        eingerichtet.
      </p>
      <img class="hero-devices" src={withBasePath('/images/orderlyze/kassensystem-showcase.png')} alt="Orderlyze Kassensystem auf Tablet, Smartphone und Drucker" width="900" height="500" loading="eager" />
      <div class="hero-checks">
        <span class="check"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#16a34a" /><path fill="white" d="m10.4 16.5-4-4 1.4-1.4 2.6 2.6 5.8-5.8 1.4 1.4z" /></svg>Funkbonieren</span>
        <span class="check"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#16a34a" /><path fill="white" d="m10.4 16.5-4-4 1.4-1.4 2.6 2.6 5.8-5.8 1.4 1.4z" /></svg>Kartenzahlung</span>
        <span class="check"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#16a34a" /><path fill="white" d="m10.4 16.5-4-4 1.4-1.4 2.6 2.6 5.8-5.8 1.4 1.4z" /></svg>100% konform</span>
      </div>
      <a class="hero-next" href="#angebot-form">Weiter</a>
    </div>
    <div class="trust-row">
      <div class="trust-badge"><strong>RKSV</strong><span>100% KONFORM</span></div>
      <div class="trust-badge"><strong>KassenSichV</strong><span>100% KONFORM</span></div>
      <div class="trust-badge"><strong>Daten Sicherheit</strong><span>Hosted in EU</span></div>
    </div>
  </section>

  <section id="angebot-form" class="band band-white form-band">
    <div class="form-wrap">
      <h2>Angebot anfordern</h2>
      <p class="form-lead">Kostenlos und unverbindlich. Wir melden uns innerhalb von 24 Stunden bei dir.</p>
      <form class="offer-form" action="mailto:office@orderlyze.com" method="post" enctype="text/plain">
        <label>
          Name *
          <input type="text" name="Name" required />
        </label>
        <label>
          E-Mail *
          <input type="email" name="E-Mail" required />
        </label>
        <label>
          Telefon
          <input type="tel" name="Telefon" />
        </label>
        <label>
          Branche *
          <select name="Branche" required>
            <option value="">Bitte wählen</option>
            <option>Restaurant</option>
            <option>Cafe</option>
            <option>Bar</option>
            <option>Friseur</option>
            <option>Beauty</option>
            <option>Sonstige Dienstleistung</option>
          </select>
        </label>
        <label class="full">
          Nachricht
          <textarea name="Nachricht" rows="4" placeholder="Wie können wir dir helfen?"></textarea>
        </label>
        <button type="submit">Jetzt Angebot anfordern</button>
        <p class="legal">
          Mit dem Absenden stimmst du unserer <a href="/Orderlyze.Astro/datenschutzerklaerung/">Datenschutzerklärung</a> zu.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }
  .band-soft { background: #fafafa; }
  .band-white { background: white; }

  .hero-card-band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
    text-align: center;
  }

  .hero-eyebrow {
    margin: 0 0 18px;
    color: #6b7280;
    font-size: 0.95rem;
  }

  .hero-card {
    max-width: 720px;
    margin: 0 auto;
    background: white;
    border-top: 4px solid var(--accent);
    border-radius: 4px;
    box-shadow: 0 18px 40px rgb(15 23 42 / 8%);
    padding: clamp(28px, 4vw, 48px);
  }

  .hero-card h1 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.15;
  }

  .hero-desc {
    margin: 0 auto 22px;
    color: #4b5563;
    max-width: 560px;
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .hero-devices {
    width: 100%;
    max-width: 500px;
    margin: 0 auto 22px;
    display: block;
  }

  .hero-checks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
    margin-bottom: 24px;
  }

  .check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .hero-next {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 38px;
    background: var(--accent);
    color: white;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .hero-next:hover { background: #044d8c; }

  .trust-row {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .trust-badge {
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 8px 14px;
    text-align: center;
    min-width: 80px;
  }

  .trust-badge strong {
    display: block;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .trust-badge span {
    display: block;
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 800;
    margin-top: 2px;
    letter-spacing: 0.04em;
  }

  .form-wrap {
    max-width: 760px;
    margin: 0 auto;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: clamp(24px, 4vw, 40px);
  }

  .form-wrap h2 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    text-align: center;
  }

  .form-lead {
    margin: 0 0 22px;
    color: #4b5563;
    text-align: center;
    font-size: 0.96rem;
  }

  .offer-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
  }

  .offer-form label {
    display: grid;
    gap: 6px;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .offer-form label.full { grid-column: span 2; }

  .offer-form input,
  .offer-form select,
  .offer-form textarea {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 10px 12px;
    font: inherit;
    color: var(--ink);
    background: white;
    font-weight: 400;
  }

  .offer-form input:focus,
  .offer-form select:focus,
  .offer-form textarea:focus {
    border-color: var(--accent);
    outline: 2px solid rgb(6 89 169 / 18%);
  }

  .offer-form button {
    grid-column: span 2;
    margin-top: 8px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .offer-form button:hover { background: #044d8c; }

  .legal {
    grid-column: span 2;
    margin: 4px 0 0;
    color: #6b7280;
    font-size: 0.78rem;
    text-align: center;
  }

  .legal a { color: var(--accent); }

  @media (max-width: 640px) {
    .usp-row { grid-template-columns: 1fr; }
    .offer-form { grid-template-columns: 1fr; }
    .offer-form label.full { grid-column: span 1; }
    .offer-form button { grid-column: span 1; }
    .legal { grid-column: span 1; }
  }
</style>
