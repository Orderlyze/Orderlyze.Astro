---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import SectionHeading from '../components/orderlyze/SectionHeading.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Preise | Orderlyze';
const description =
  'Die Preise für das Orderlyze Kassensystem im Überblick: monatliche Software-Lizenz ab 39€ und einmalige Hardware-Kosten. Transparent und finanzamtkonform.';
const canonical = '/preise/';
const siteUrl = absoluteSiteUrl(Astro.site);

const tiers = [
  {
    name: 'Dienstleistungen',
    price: '39€',
    bullets: ['alle Funktionen enthalten', 'kostenloser Support', 'Finanzamt Signatur inkl.', 'keine zusätzlichen Kosten!'],
  },
  {
    name: 'Gastronomie',
    price: '49€',
    featured: true,
    bullets: ['alle Funktionen enthalten', 'kostenloser Support', 'Finanzamt Signatur inkl.', 'keine zusätzlichen Kosten!'],
  },
  {
    name: 'Gastronomie +',
    price: '75€',
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'mit Küchenkommunikation',
      'unbegrenzt viele Geräte',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
];

const kassenbuchPoints = [
  'Finanzamtkonforme Kassenbuchführung',
  'Daten-Export zur Steuerberatung',
  'Perfekt ins Kassensystem integriert',
  'Automatische Übertragung aus der Kasse',
  'Fortlaufende und automatische Nummerierung',
  'Alle Einnahmen und Ausgaben erfassen',
  'Automatischer Verlauf aller Bar-Transaktionen',
  'Getrennte Mehrwertsteuer-Positionen',
  'Aktueller Kassenstand jederzeit',
  'Von allen Geräten abrufbereit',
];

const samsungPakete = [
  {
    name: 'Samsung Kassensystem Paket 1',
    items: ['Samsung Tab A9+', 'Bondrucker', 'Tablet Ständer'],
    total: '448,80€',
  },
  {
    name: 'Samsung Kassensystem Paket 2',
    items: ['Samsung Tab A9+', 'Tablet Ständer', 'Bondrucker', 'Kassenlade K-2'],
    total: '534,40€',
  },
];

const ipadPakete = [
  {
    name: 'Ipad Kassensystem Paket 1',
    items: ['Ipad 9. Generation', 'Bondrucker', 'Tablet Ständer'],
    total: '612,80€',
  },
  {
    name: 'Ipad Kassensystem Paket 2',
    items: ['Ipad 9. Generation', 'Tablet Ständer', 'Bondrucker', 'Kassenlade K-2'],
    total: '698,40€',
  },
];

const zubehoer = [
  { name: 'Tablet Ständer', desc: '', price: '22,90€' },
  { name: 'Kassenlade K-4', desc: '245 x 320 x 105 mm; 3kg, 3 Münzfächer, 3 Scheinfächer', price: '69,90€' },
  { name: 'Cloud Drucker', desc: 'WLAN Bondrucker für mehrere Geräte', price: '265,00€' },
  { name: 'Kassenlade K-2', desc: '330 x 101 x 330mm; 5,2kg, 8 Münz-, 4 Scheinfächer, 1 Scheckfach', price: '85,60€' },
  { name: 'Kassenlade APG', desc: '330 x 360 x 100mm; 5,2kg, 8 Münz-, 5 Scheinfächer', price: '85,60€' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/hero-system.png"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  }}
>
  <HeroPhoto
    image="/images/orderlyze/checkout-counter.jpg"
    title="Unsere Preise"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    overlay="dark"
  />

  <section class="band band-white">
    <SectionHeading title="Die Kosten für das Orderlyze Kassensystem bestehen aus 2 Teilen" />
    <div class="cost-parts">
      <div class="cost-part">
        <div class="cost-step">1</div>
        <h3>monatliche Kosten</h3>
        <p>Software Lizenz + Finanzamt Signatur</p>
      </div>
      <div class="cost-part">
        <div class="cost-step">2</div>
        <h3>einmalige Kosten</h3>
        <p>Die Hardware/Geräte, die du benötigst</p>
      </div>
    </div>
  </section>

  <section class="band band-soft">
    <SectionHeading title="1. monatliche Kosten" />
    <div class="tiers">
      {tiers.map((t) => (
        <article class:list={['tier', { featured: t.featured }]}>
          <h3>{t.name}</h3>
          <ul>
            {t.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <div class="tier-total">
            <span>GESAMT</span>
            <strong>{t.price}</strong>
            <small>pro Monat</small>
          </div>
          <a class="tier-cta" href="/Orderlyze.Astro/angebot/">Kassensystem bestellen</a>
        </article>
      ))}
    </div>
    <p class="footnote">*Preise exkl. MwSt. Einmalige Aktivierungsgebühr € 199,-</p>
  </section>

  <section class="band band-white">
    <SectionHeading title="Kassenbuch" />
    <p class="intro-lead">Im Orderlyze Kassensystem inklusive. Du musst dich um nichts kümmern.</p>
    <div class="kbuch-grid">
      {kassenbuchPoints.map((k) => (
        <div class="kbuch-row">
          <span class="tick" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M6.3 11.5 2.7 7.9l1.4-1.4 2.2 2.2 5.6-5.6 1.4 1.4z" /></svg>
          </span>
          {k}
        </div>
      ))}
    </div>
  </section>

  <section class="band band-soft">
    <SectionHeading title="2. einmalige Kosten für die Hardware" />

    <h3 class="hw-group-title">Samsung Tablet Kassensystem</h3>
    <div class="hw-base">
      <div class="hw-base-cell">
        <strong>Samsung Tab A9+</strong>
        <span>205,90€</span>
      </div>
      <div class="hw-base-plus">+</div>
      <div class="hw-base-cell">
        <strong>Bondrucker Bluetooth</strong>
        <span>220€ (Cloud: 265€)</span>
      </div>
      <div class="hw-base-eq">=</div>
      <div class="hw-base-cell total">
        <strong>Gesamt</strong>
        <span>425,90€</span>
      </div>
    </div>
    <div class="paket-grid">
      {samsungPakete.map((p) => (
        <article class="paket">
          <h4>{p.name}</h4>
          <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
          <div class="paket-total">{p.total}</div>
        </article>
      ))}
    </div>

    <h3 class="hw-group-title">Ipad Kassensystem</h3>
    <div class="hw-base">
      <div class="hw-base-cell">
        <strong>Ipad 9. Generation</strong>
        <span>369,90€</span>
      </div>
      <div class="hw-base-plus">+</div>
      <div class="hw-base-cell">
        <strong>Bondrucker Bluetooth</strong>
        <span>220€ (Cloud: 265€)</span>
      </div>
      <div class="hw-base-eq">=</div>
      <div class="hw-base-cell total">
        <strong>Gesamt</strong>
        <span>589,90€</span>
      </div>
    </div>
    <div class="paket-grid">
      {ipadPakete.map((p) => (
        <article class="paket">
          <h4>{p.name}</h4>
          <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
          <div class="paket-total">{p.total}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="band band-white">
    <SectionHeading title="Zubehör" />
    <div class="zubehoer-grid">
      {zubehoer.map((z) => (
        <article class="zubehoer">
          <h4>{z.name}</h4>
          {z.desc && <p>{z.desc}</p>}
          <strong>{z.price}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="band band-soft">
    <SectionHeading title="All-In-One Geräte" />
    <div class="all-in-one">
      <article>
        <h3>Sunmi V2 Pro</h3>
        <p>inkl. Bondrucker und Kartenlesegerät</p>
        <strong>399,00€</strong>
      </article>
    </div>
  </section>

  <BlueCta
    title="Hol dir dein individuelles Angebot"
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }

  .band-soft { background: #fafafa; }
  .band-white { background: white; }

  .intro-lead {
    max-width: 760px;
    margin: -8px auto 22px;
    color: #4b5563;
    text-align: center;
    font-size: 1rem;
    line-height: 1.55;
  }

  .cost-parts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cost-part {
    text-align: center;
    padding: 24px;
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
  }

  .cost-step {
    width: 40px; height: 40px;
    margin: 0 auto 10px;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-weight: 900;
    display: grid;
    place-items: center;
  }

  .cost-part h3 {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 1.05rem;
  }

  .cost-part p {
    margin: 0;
    color: #4b5563;
    font-size: 0.92rem;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .tier {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 28px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tier.featured {
    border-color: var(--accent);
    box-shadow: 0 18px 36px rgb(6 89 169 / 14%);
    transform: translateY(-8px);
  }

  .tier h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.4rem;
  }

  .tier ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: #4b5563;
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .tier li {
    padding: 8px 0;
    border-bottom: 1px solid #f1f3f5;
  }

  .tier li:last-child {
    border-bottom: 0;
  }

  .tier-total span {
    display: block;
    color: #9ca3af;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tier-total strong {
    display: block;
    color: var(--accent);
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1;
    margin-top: 4px;
  }

  .tier-total small {
    color: #6b7280;
    font-size: 0.82rem;
  }

  .tier-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    line-height: 44px;
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    font-size: 0.8rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .tier-cta:hover {
    background: #044d8c;
  }

  .footnote {
    margin-top: 22px;
    text-align: center;
    color: #6b7280;
    font-size: 0.82rem;
  }

  .kbuch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 32px;
    max-width: 880px;
    margin: 0 auto;
  }

  .kbuch-row {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: center;
    color: var(--ink);
    font-size: 0.96rem;
  }

  .tick { color: var(--accent); }

  .hw-group-title {
    text-align: center;
    margin: 18px 0 14px;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .hw-base {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    max-width: 980px;
    margin: 0 auto 18px;
    flex-wrap: wrap;
  }

  .hw-base-cell {
    flex: 1 1 200px;
    min-width: 180px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 14px 18px;
    text-align: center;
  }

  .hw-base-cell strong { display: block; color: var(--ink); font-size: 0.98rem; }
  .hw-base-cell span { color: var(--accent); font-size: 1.1rem; font-weight: 800; }

  .hw-base-cell.total { background: var(--accent); border-color: var(--accent); }
  .hw-base-cell.total strong, .hw-base-cell.total span { color: white; }

  .hw-base-plus, .hw-base-eq {
    color: var(--accent);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .paket-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    max-width: 980px;
    margin: 0 auto 28px;
  }

  .paket {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 22px;
    text-align: center;
  }

  .paket h4 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 1.05rem;
  }

  .paket ul {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    color: #4b5563;
    font-size: 0.92rem;
  }

  .paket li { padding: 4px 0; }

  .paket-total {
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 900;
  }

  .zubehoer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .zubehoer {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 18px 20px;
  }

  .zubehoer h4 {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 1rem;
  }

  .zubehoer p {
    margin: 0 0 10px;
    color: #6b7280;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .zubehoer strong {
    color: var(--accent);
    font-size: 1.1rem;
    font-weight: 900;
  }

  .all-in-one {
    display: flex;
    justify-content: center;
  }

  .all-in-one article {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 22px 36px;
    text-align: center;
    min-width: 280px;
  }

  .all-in-one h3 { margin: 0 0 4px; color: var(--ink); }
  .all-in-one p { margin: 0 0 12px; color: #6b7280; font-size: 0.92rem; }
  .all-in-one strong { color: var(--accent); font-size: 1.5rem; font-weight: 900; }

  @media (max-width: 800px) {
    .cost-parts, .tiers, .paket-grid { grid-template-columns: 1fr; }
    .kbuch-grid { grid-template-columns: 1fr; }
    .tier.featured { transform: none; }
  }
</style>
