---
/**
 * /ratgeber/<slug> — rendert die Markdown-Artikel aus src/content/ratgeber/.
 * Neuer Artikel = neue .md-Datei dort ablegen, sonst nichts nötig.
 */
import RatgeberArtikel from '../../components/templates/RatgeberArtikel.astro';
import type { RatgeberFrontmatter } from '../../components/templates/RatgeberArtikel.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/ratgeber/*.md', { eager: true }) as Record<
    string,
    { frontmatter: RatgeberFrontmatter; Content: any }
  >;
  const artikel = Object.entries(modules).map(([path, mod]) => ({
    slug: path.split('/').pop()!.replace('.md', ''),
    mod,
  }));
  return artikel.map(({ slug, mod }) => ({
    params: { slug },
    props: {
      frontmatter: mod.frontmatter,
      Content: mod.Content,
      weitere: artikel
        .filter((a) => a.slug !== slug)
        .sort((a, b) => (a.mod.frontmatter.order ?? 99) - (b.mod.frontmatter.order ?? 99))
        .map((a) => ({ slug: a.slug, h1: a.mod.frontmatter.h1, teaser: a.mod.frontmatter.teaser })),
    },
  }));
}

const { frontmatter, Content, weitere } = Astro.props;
const { slug } = Astro.params;
---

<RatgeberArtikel frontmatter={frontmatter} slug={slug} weitere={weitere}>
  <Content />
</RatgeberArtikel>
