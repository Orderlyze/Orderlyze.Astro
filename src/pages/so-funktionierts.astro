---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPhoto from '../components/orderlyze/HeroPhoto.astro';
import SectionHeading from '../components/orderlyze/SectionHeading.astro';
import StepCards from '../components/orderlyze/StepCards.astro';
import SplitCard from '../components/orderlyze/SplitCard.astro';
import AppDownload from '../components/orderlyze/AppDownload.astro';
import BlueCta from '../components/orderlyze/BlueCta.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = "So funktioniert's | Orderlyze";
const description =
  "In nur 4 Schritten zu deinem Kassensystem. Hier kannst du dir durchlesen, wie einfach du mit Orderlyze losglegen kannst.";
const canonical = '/so-funktionierts/';
const siteUrl = absoluteSiteUrl(Astro.site);

const steps = [
  {
    title: 'Angebot anfordern',
    description: 'Hol dir ein unverbindliches Angebot und erhalte einen kostenlosen Testaccount.',
  },
  {
    title: 'App herunterladen',
    description: 'Lade dir die App vom App Store herunter und installiere diese.',
  },
  {
    title: 'Unternehmen einrichten',
    description: 'Verwalte mit orderlyze web dein Unternehmen und richte alles ein.',
  },
  {
    title: 'Angebot annehmen',
    description: 'Wir unterstützen dich bei allem und übernehmen die Finanzamtverbindung.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'de-DE',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: "So funktioniert's", item: new URL(canonical, siteUrl).toString() },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/orderlyze/home-hero-person.jpg"
  jsonLd={jsonLd}
>
  <HeroPhoto
    image="/images/orderlyze/home-hero-person.jpg"
    title="So funktioniert's"
    cta={{ label: 'Jetzt loslegen', href: '/angebot/' }}
  />

  <section class="band band-soft">
    <SectionHeading title={'In nur 4 Schritten zum\nfinanzamtkonformen Kassensystem'} />
    <StepCards steps={steps} />
  </section>

  <SplitCard
    background="white"
    variant="plain"
    title="So einfach läuft es bei uns ab"
    body="Orderlyze ist ein App Kassensystem. Das heißt, du kannst es dir auf jedes Android und iOS Smartphone und Tablet herunterladen. Sobald du deinen Kassensystem Account von uns erhalten hast, kannst du die App auf einem beliebigen Gerät installieren und sofort loslegen. Schnell und einfach kannst du jetzt das Kassensystem individuell für dein Unternehmen einrichten. Und so funktioniert's:"
  />

  <section class="band band-white">
    <div class="two-col-cards">
      <article class="info-card">
        <h2>Arbeiten - Orderlyze App</h2>
        <p>Die Orderlyze App ist dein Kassensystem, mit der du die Rechnungen erstellst. Diese installierst du auf den Geräten, mit denen du arbeitest. Die App ist das, mit dem du täglich arbeitest und wodurch du effizienter und zeitsparender vorgehen kannst. Um dein Unternehmen zu verwalten oder Einstellungen zu treffen, kannst du im Menü zu der Verwaltung wechseln.</p>
      </article>
      <article class="info-card">
        <h2>Verwalten - orderlyze web</h2>
        <p>orderlyze web ist eine Website, die du mit jedem Browser (z. B. Google Chrome, Firefox, Safari) oder im Menü der App (Verwaltung) öffnen kannst. Dort kannst du zum Beispiel deine Produktgruppen und Produkte anlegen oder deine Berichte für die Steuerberatung herunterladen. Außerdem kannst du einstellen, wie deine Rechnung aussehen soll.</p>
      </article>
    </div>
  </section>

  <section class="band band-soft">
    <div class="two-cta-row">
      <div class="two-cta-col">
        <SectionHeading title="Hier kannst du die App herunterladen" size="md" />
        <AppDownload />
      </div>
      <div class="two-cta-col">
        <SectionHeading title="Und hier gehts zur Verwaltung" size="md" />
        <a class="solid-cta" href="https://web.orderlyze.com" target="_blank" rel="noopener">Jetzt Unternehmen verwalten</a>
      </div>
    </div>
  </section>

  <SplitCard
    background="white"
    image="/images/orderlyze/support.jpg"
    imageSide="right"
    title="Kostenloser Support für alle Kunden"
    body="Egal ob du Unterstützung bei der Einrichtung oder Hilfe beim laufenden Betrieb benötigst. Wir sind stets erreichbar und unterstützen dich völlig kostenlos."
    bullets={[
      'Jederzeit telefonisch und per E-Mail und WhatsApp erreichbar',
      'Keine zusätzlichen Kosten',
      'Wir unterstützen dich von Anfang an',
    ]}
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
  />

  <SplitCard
    background="soft"
    image="/images/orderlyze/konform-2.png"
    imageSide="left"
    title="Mit Orderlyze bist du zu 100% finanzamtkonform"
    body="Mit Orderlyze musst du dir über das Finanzamt keine Sorgen machen. Am Beginn einmal eingestellt, werden alle Daten automatisch übermittelt und du musst dich um nichts mehr kümmern."
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
  />

  <BlueCta
    title="Hol dir jetzt das Kassensystem."
    cta={{ label: 'Angebot anfordern', href: '/angebot/' }}
    note="Kostenlos und Unverbindlich."
  />
</BaseLayout>

<style>
  .band {
    padding: clamp(28px, 4vw, 56px) max(24px, calc((100vw - 1180px) / 2));
  }

  .band-soft {
    background: #fafafa;
  }

  .band-white {
    background: white;
  }

  .two-col-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .info-card {
    padding: 28px 30px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
  }

  .info-card h2 {
    margin: 0 0 12px;
    color: var(--brand-blue-dark);
    font-family: "Raleway", sans-serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 3vw, 35px);
    line-height: 1.4;
  }

  .info-card p {
    margin: 0;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 800px) {
    .two-col-cards {
      grid-template-columns: 1fr;
    }
  }

  .two-cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    max-width: 1080px;
    margin: 0 auto;
    align-items: start;
  }

  .two-cta-col {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
  }

  .solid-cta {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    height: 50px;
    line-height: 50px;
    padding: 0 28px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.88rem;
  }

  .solid-cta:hover {
    background: #044d8c;
  }

  @media (max-width: 800px) {
    .two-cta-row {
      grid-template-columns: 1fr;
    }
  }
</style>
