---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  canonicalFromPage,
  contentBlocks,
  contentSections,
  pageDescription,
  pageKeyword,
  pageSchema,
  pageTitle,
  slugParamFromPage,
} from '../lib/orderlyze-pages';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

export async function getStaticPaths() {
  const pages = await getCollection('orderlyzePages');
  return pages
    .filter((page) => page.id !== 'home')
    .map((page) => ({
      params: { slug: slugParamFromPage(page) },
      props: { page },
    }));
}

const { page } = Astro.props;
const title = pageTitle(page);
const description = pageDescription(page);
const canonical = canonicalFromPage(page);
const keyword = pageKeyword(page);
const siteUrl = absoluteSiteUrl(Astro.site);
const sections = contentSections(page);

const heroHeading = title
  .replace(/\s+\|\s+Orderlyze$/, '')
  .replace(/^Orderlyze\s+[-|]\s+/i, '')
  .trim();
const heroHeadingLower = heroHeading.toLowerCase();

const LEGAL_IDS = new Set(['agb', 'impressum', 'datenschutzerklaerung']);
const BRANCHES_ID = 'branchen';
const PRICING_ID = 'preise';
const MINIMAL_IDS = new Set(['dank']);
const isLegal = LEGAL_IDS.has(page.id);
const isBranches = page.id === BRANCHES_ID;
const isPricing = page.id === PRICING_ID;
const isMinimal = MINIMAL_IDS.has(page.id);

const heroIntro = sections.find((s) => s.paragraphs.length > 0)?.paragraphs[0] || description;

const featureSections = sections
  .filter((s) => s.heading && s.heading.toLowerCase() !== heroHeadingLower)
  .filter((s) => s.paragraphs.length > 0)
  .filter((s) => s.heading.length >= 10 || s.heading.split(/\s+/).length >= 2)
  .slice(0, 6);

const bulletSections = sections
  .filter((s) => s.heading && s.paragraphs.length === 0)
  .map((s) => s.heading)
  .filter((heading) => heading.toLowerCase() !== heroHeadingLower)
  .filter((heading) => heading.length >= 8 && heading.length <= 60)
  .filter((heading) => heading.split(/\s+/).length >= 2)
  .slice(0, 9);

const featureImages = [
  '/images/orderlyze/checkout-counter.jpg',
  '/images/orderlyze/app-phone.png',
  '/images/orderlyze/card-payment.jpg',
  '/images/orderlyze/accounting.jpg',
  '/images/orderlyze/devices-small.jpg',
  '/images/orderlyze/support.jpg',
];

const pageImage = page.id === 'kassensystem'
  ? '/images/orderlyze/kassensystem-showcase.png'
  : page.id === 'kartenzahlung'
    ? '/images/orderlyze/card-payment.jpg'
    : page.id === 'verwaltung'
      ? '/images/orderlyze/accounting.jpg'
      : page.id === 'funktionen'
        ? '/images/orderlyze/funktionen-illustration.png'
        : page.id === 'preise'
          ? '/images/orderlyze/hero-system.png'
          : page.id === 'restaurant'
            ? '/images/orderlyze/branch-restaurant.jpg'
            : page.id === 'cafe'
              ? '/images/orderlyze/branch-cafe.jpg'
              : page.id === 'bar'
                ? '/images/orderlyze/branch-bar.jpg'
                : page.id === 'friseur' || page.id === 'friseure'
                  ? '/images/orderlyze/branch-friseur.jpg'
                  : page.id === 'beauty'
                    ? '/images/orderlyze/branch-beauty.jpg'
                    : '/images/orderlyze/hero-system.png';

const testimonials = [
  {
    image: '/images/orderlyze/customer-carlo.jpg',
    name: 'Carlo M.',
    role: 'Pizzeria',
    copy: 'Seit dem wir Orderlyze verwenden, haben wir kaum noch Probleme gehabt. Alles geht super einfach und wir haben eine enorme Flexibilität.',
  },
  {
    image: '/images/orderlyze/customer-helene.jpg',
    name: 'Helene S.',
    role: 'Kosmetikerin',
    copy: 'Orderlyze hat mir den Alltag deutlich erleichtert. Ich gelange sehr viel schneller an wichtige Informationen.',
  },
];

const gastroBranches = [
  ['Restaurant', '/restaurant/', '/images/orderlyze/branch-restaurant.jpg'],
  ['Cafe', '/cafe/', '/images/orderlyze/branch-cafe.jpg'],
  ['Bar', '/bar/', '/images/orderlyze/branch-bar.jpg'],
];
const serviceBranches = [
  ['Friseur', '/friseur/', '/images/orderlyze/branch-friseur.jpg'],
  ['Beauty', '/beauty/', '/images/orderlyze/branch-beauty.jpg'],
  ['Sonstige', '/sonstige/', '/images/orderlyze/branch-physio.jpg'],
];

const pricingTiers = [
  {
    name: 'Dienstleistungen',
    price: '39€',
    period: 'pro Monat',
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
  {
    name: 'Gastronomie',
    price: '49€',
    period: 'pro Monat',
    featured: true,
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
  {
    name: 'Gastronomie +',
    price: '75€',
    period: 'pro Monat',
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'mit Küchenkommunikation',
      'unbegrenzt viele Geräte',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
];

const legalBlocks = isLegal ? contentBlocks(page).filter((line) => line.toLowerCase() !== heroHeadingLower) : [];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={pageImage}
  jsonLd={pageSchema(page, siteUrl)}
>
  {
    isLegal ? (
      <>
        <section class="legal-banner">
          <div class="container">
            <h1>{heroHeading}</h1>
          </div>
        </section>
        <section class="legal-body">
          <div class="container">
            {legalBlocks.map((line) => <p>{line}</p>)}
          </div>
        </section>
      </>
    ) : (
      <section class="page-hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">{keyword}</p>
            <h1>{heroHeading}</h1>
            <p class="lead">{heroIntro}</p>
            <div class="hero-actions">
              <a class="button primary" href={withBasePath('/angebot/')}>Kostenloses Angebot</a>
              <a class="button secondary" href="tel:08004004511">0800 400 4511</a>
            </div>
            <p class="hero-trust">Kostenlos und unverbindlich • 100% finanzamtkonform</p>
          </div>
          <figure class="hero-visual">
            <img src={withBasePath(pageImage)} alt={`${heroHeading} - Orderlyze`} width="1080" height="900" loading="eager" decoding="async" />
          </figure>
        </div>
      </section>
    )
  }

  {
    isBranches && (
      <>
        <section class="section branches-section">
          <div class="container center">
            <h2>Gastronomie</h2>
            <div class="branches-grid">
              {gastroBranches.map(([label, href, image]) => (
                <a class="branch-card" href={withBasePath(href)}>
                  <img src={withBasePath(image)} alt={`${label} mit Orderlyze Kassensystem`} width="411" height="452" loading="eager" />
                  <span>{label}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="section branches-section soft">
          <div class="container center">
            <h2>Dienstleistungen</h2>
            <div class="branches-grid">
              {serviceBranches.map(([label, href, image]) => (
                <a class="branch-card" href={withBasePath(href)}>
                  <img src={withBasePath(image)} alt={`${label} mit Orderlyze Kassensystem`} width="411" height="452" loading="eager" />
                  <span>{label}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    isPricing && (
      <section class="section pricing-section">
        <div class="container center">
          <h2>Unsere Preise</h2>
          <p class="section-lead">Die Kosten für das Orderlyze Kassensystem bestehen aus monatlicher Software-Lizenz und einmaliger Hardware.</p>
          <div class="pricing-grid">
            {pricingTiers.map((tier) => (
              <article class:list={['pricing-card', { featured: tier.featured }]}>
                <h3>{tier.name}</h3>
                <ul>
                  {tier.bullets.map((b) => <li>{b}</li>)}
                </ul>
                <div class="pricing-total">
                  <span>GESAMT</span>
                  <strong>{tier.price}</strong>
                  <small>{tier.period}</small>
                </div>
                <a class="button primary" href={withBasePath('/angebot/')}>Kassensystem bestellen</a>
              </article>
            ))}
          </div>
          <p class="pricing-note">*Preise exkl. MwSt. Einmalige Aktivierungsgebühr € 199,-</p>
        </div>
      </section>
    )
  }

  {
    !isLegal && !isBranches && !isPricing && bulletSections.length >= 3 && (
      <section class="section bullets-section">
        <div class="container center">
          <h2>Auf einen Blick</h2>
          <div class="bullet-grid">
            {bulletSections.map((item) => (
              <div class="bullet-card">
                <span class="bullet-dot" aria-hidden="true"></span>
                {item}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isLegal && !isBranches && !isPricing &&
      featureSections.map((section, index) => (
        <section class:list={['feature-row', { reverse: index % 2 === 1 }]}>
          <div class="feature-copy">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <figure class="feature-visual">
            <img
              src={withBasePath(featureImages[index % featureImages.length])}
              alt=""
              width="900"
              height="700"
              loading="eager"
              decoding="async"
            />
          </figure>
        </section>
      ))
  }

  {
    !isLegal && !isMinimal && (
      <section class="section testimonials-section">
        <div class="container">
          <h2 class="testimonials-title">Unzählige Kunden schenken uns ihr Vertrauen</h2>
          <div class="testimonial-grid">
            {testimonials.map((t, i) => (
              <article class:list={['testimonial-row', { reverse: i % 2 === 1 }]}>
                <img src={withBasePath(t.image)} alt={`${t.name} nutzt Orderlyze`} width="685" height="531" loading="eager" />
                <div class="testimonial-copy">
                  <span aria-hidden="true">”</span>
                  <h3>{t.name}</h3>
                  <strong>{t.role}</strong>
                  <p>{t.copy}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isLegal && (
      <section class="black-cta">
        <h2>Interessiert? Dann hol dir ein unverbindliches Angebot!</h2>
        <a class="button primary" href={withBasePath('/angebot/')}>Angebot anfordern</a>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-hero {
    padding: clamp(48px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
    background: #f7f8fb;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .lead {
    margin: 24px 0 0;
    max-width: 540px;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero-trust {
    margin: 18px 0 0;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .hero-visual {
    margin: 0;
  }

  .hero-visual img {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .legal-banner {
    padding: 56px 0;
    background: var(--accent);
    color: white;
    text-align: center;
  }

  .legal-banner h1 {
    color: white;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .legal-body {
    padding: 56px 0;
    background: white;
  }

  .legal-body .container {
    max-width: 920px;
  }

  .legal-body p {
    margin: 0 0 12px;
    color: #1f2937;
    font-size: 0.96rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .bullets-section,
  .branches-section {
    background: white;
  }

  .branches-section.soft {
    background: var(--soft);
  }

  .center h2 {
    margin: 0 0 36px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.05;
    text-align: center;
  }

  .section-lead {
    margin: -20px auto 32px;
    max-width: 720px;
    text-align: center;
    color: var(--muted);
  }

  .bullet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    text-align: left;
  }

  .bullet-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--soft);
    color: var(--ink);
    font-weight: 700;
  }

  .bullet-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 999px;
    background: var(--accent);
  }

  .branches-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .branch-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 12px;
    color: var(--ink);
  }

  .branch-card img {
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  .branch-card span {
    position: absolute;
    left: 0;
    bottom: 0;
    min-width: 64%;
    padding: 14px 18px;
    background: white;
    font-weight: 900;
  }

  .pricing-section {
    background: white;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 32px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
    box-shadow: 0 16px 36px rgb(15 23 42 / 6%);
  }

  .pricing-card.featured {
    border-color: var(--accent);
    box-shadow: 0 20px 44px rgb(6 89 169 / 16%);
    transform: translateY(-8px);
  }

  .pricing-card h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .pricing-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .pricing-card li {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }

  .pricing-card li:last-child {
    border-bottom: 0;
  }

  .pricing-total {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .pricing-total span {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing-total strong {
    font-size: 2.4rem;
    color: var(--accent);
    font-weight: 900;
    line-height: 1;
  }

  .pricing-total small {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .pricing-note {
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(48px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .feature-row.reverse {
    background: var(--soft);
  }

  .feature-row.reverse .feature-copy {
    order: 2;
  }

  .feature-copy h2 {
    margin: 0 0 18px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 1.05;
  }

  .feature-copy p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 540px;
  }

  .feature-visual {
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .feature-visual img {
    width: 100%;
    max-width: 540px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 30px 60px rgb(15 23 42 / 12%);
  }

  .testimonials-section {
    padding: clamp(56px, 8vw, 96px) 0;
    background: white;
  }

  .testimonials-title {
    margin: 0 0 36px;
    text-align: center;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
  }

  .testimonial-grid {
    display: grid;
    gap: 24px;
  }

  .testimonial-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: stretch;
  }

  .testimonial-row.reverse {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .testimonial-row.reverse img {
    order: 2;
  }

  .testimonial-row img {
    width: 100%;
    min-height: 380px;
    object-fit: cover;
    border-radius: 12px;
  }

  .testimonial-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 4vw, 60px);
    background: var(--soft);
    border-radius: 12px;
  }

  .testimonial-copy span {
    position: absolute;
    top: 18px;
    right: 28px;
    color: var(--ink);
    font-size: 4rem;
    line-height: 1;
    font-weight: 900;
  }

  .testimonial-copy h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .testimonial-copy strong {
    margin: 6px 0 16px;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .testimonial-copy p {
    margin: 0;
    color: var(--muted);
  }

  .black-cta {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: clamp(64px, 9vw, 96px) 20px;
    background: #000000;
    color: white;
    text-align: center;
  }

  .black-cta h2 {
    margin: 0;
    color: white;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .black-cta p {
    margin: 0;
    max-width: 600px;
    color: #d1d5db;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .feature-row,
    .branches-grid,
    .pricing-grid,
    .testimonial-row,
    .testimonial-row.reverse {
      grid-template-columns: 1fr;
    }

    .feature-row.reverse .feature-copy,
    .testimonial-row.reverse img {
      order: 0;
    }

    .pricing-card.featured {
      transform: none;
    }
  }
</style>
