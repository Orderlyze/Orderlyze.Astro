---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  canonicalFromPage,
  contentSections,
  pageDescription,
  pageKeyword,
  pageSchema,
  pageTitle,
  slugParamFromPage,
} from '../lib/orderlyze-pages';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

export async function getStaticPaths() {
  const pages = await getCollection('orderlyzePages');
  return pages
    .filter((page) => page.id !== 'home')
    .map((page) => ({
      params: { slug: slugParamFromPage(page) },
      props: { page },
    }));
}

const { page } = Astro.props;
const title = pageTitle(page);
const description = pageDescription(page);
const canonical = canonicalFromPage(page);
const keyword = pageKeyword(page);
const siteUrl = absoluteSiteUrl(Astro.site);
const sections = contentSections(page);

const heroHeading = title.replace(/\s+\|\s+Orderlyze$/, '').replace(/^Orderlyze\s+[-|]\s+/i, '');

const heroIntro = sections.find((s) => s.paragraphs.length > 0)?.paragraphs[0] || description;
const heroHeadingLower = heroHeading.toLowerCase();

const featureSections = sections
  .filter((s) => s.heading && s.heading.toLowerCase() !== heroHeadingLower)
  .filter((s) => s.paragraphs.length > 0)
  .filter((s) => s.heading.length >= 10 || s.heading.split(/\s+/).length >= 2)
  .slice(0, 6);

const bulletSections = sections
  .filter((s) => s.heading && s.paragraphs.length === 0)
  .map((s) => s.heading)
  .filter((heading) => heading.toLowerCase() !== heroHeadingLower)
  .filter((heading) => heading.length >= 8 && heading.length <= 60)
  .filter((heading) => heading.split(/\s+/).length >= 2)
  .slice(0, 9);

const featureImages = [
  '/images/orderlyze/checkout-counter.jpg',
  '/images/orderlyze/app-phone.png',
  '/images/orderlyze/card-payment.jpg',
  '/images/orderlyze/accounting.jpg',
  '/images/orderlyze/devices-small.jpg',
  '/images/orderlyze/support.jpg',
];

const pageImage = page.id === 'kassensystem'
  ? '/images/orderlyze/kassensystem-showcase.png'
  : page.id === 'kartenzahlung'
    ? '/images/orderlyze/card-payment.jpg'
    : page.id === 'verwaltung'
      ? '/images/orderlyze/accounting.jpg'
      : page.id === 'funktionen'
        ? '/images/orderlyze/funktionen-illustration.png'
        : page.id === 'preise'
          ? '/images/orderlyze/hero-system.png'
          : page.id === 'restaurant'
            ? '/images/orderlyze/branch-restaurant.jpg'
            : page.id === 'cafe'
              ? '/images/orderlyze/branch-cafe.jpg'
              : page.id === 'bar'
                ? '/images/orderlyze/branch-bar.jpg'
                : page.id === 'friseur' || page.id === 'friseure'
                  ? '/images/orderlyze/branch-friseur.jpg'
                  : page.id === 'beauty'
                    ? '/images/orderlyze/branch-beauty.jpg'
                    : '/images/orderlyze/hero-system.png';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={pageImage}
  jsonLd={pageSchema(page, siteUrl)}
>
  <section class="page-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{keyword}</p>
        <h1>{heroHeading}</h1>
        <p class="lead">{heroIntro}</p>
        <div class="hero-actions">
          <a class="button primary" href={withBasePath('/angebot/')}>Kostenloses Angebot</a>
          <a class="button secondary" href="tel:08004004511">0800 400 4511</a>
        </div>
        <p class="hero-trust">Kostenlos und unverbindlich • 100% finanzamtkonform</p>
      </div>
      <figure class="hero-visual">
        <img src={withBasePath(pageImage)} alt={`${heroHeading} - Orderlyze`} width="1080" height="900" loading="eager" decoding="async" />
      </figure>
    </div>
  </section>

  {
    bulletSections.length >= 3 && (
      <section class="section bullets-section">
        <div class="container center">
          <h2>Auf einen Blick</h2>
          <div class="bullet-grid">
            {bulletSections.map((item) => (
              <div class="bullet-card">
                <span class="bullet-dot" aria-hidden="true"></span>
                {item}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featureSections.map((section, index) => (
      <section class:list={['feature-row', { reverse: index % 2 === 1 }]}>
        <div class="feature-copy">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <figure class="feature-visual">
          <img
            src={withBasePath(featureImages[index % featureImages.length])}
            alt=""
            width="900"
            height="700"
            loading="eager"
            decoding="async"
          />
        </figure>
      </section>
    ))
  }

  <section class="black-cta">
    <h2>Hol dir jetzt ein kostenloses Angebot!</h2>
    <p>Lass dich kostenlos beraten und finde heraus, wie Orderlyze deinen Betrieb einfacher macht.</p>
    <a class="button primary" href={withBasePath('/angebot/')}>Angebot anfordern</a>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: clamp(48px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
    background: #f7f8fb;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .lead {
    margin: 24px 0 0;
    max-width: 540px;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero-trust {
    margin: 18px 0 0;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .hero-visual {
    margin: 0;
  }

  .hero-visual img {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .bullets-section {
    background: white;
  }

  .center h2 {
    margin: 0 0 36px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.05;
  }

  .bullet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    text-align: left;
  }

  .bullet-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--soft);
    color: var(--ink);
    font-weight: 700;
  }

  .bullet-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 999px;
    background: var(--accent);
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(48px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
    background: white;
  }

  .feature-row.reverse {
    background: var(--soft);
  }

  .feature-row.reverse .feature-copy {
    order: 2;
  }

  .feature-copy h2 {
    margin: 0 0 18px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 1.05;
  }

  .feature-copy p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 540px;
  }

  .feature-visual {
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .feature-visual img {
    width: 100%;
    max-width: 540px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 30px 60px rgb(15 23 42 / 12%);
  }

  .black-cta {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: clamp(64px, 9vw, 96px) 20px;
    background: #000000;
    color: white;
    text-align: center;
  }

  .black-cta h2 {
    margin: 0;
    color: white;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .black-cta p {
    margin: 0;
    max-width: 600px;
    color: #d1d5db;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .feature-row {
      grid-template-columns: 1fr;
    }

    .feature-row.reverse .feature-copy {
      order: 0;
    }
  }
</style>
