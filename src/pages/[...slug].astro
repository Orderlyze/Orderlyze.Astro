---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  canonicalFromPage,
  contentBlocks,
  contentSections,
  pageDescription,
  pageKeyword,
  pageSchema,
  pageTitle,
  slugParamFromPage,
} from '../lib/orderlyze-pages';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

const DEDICATED_PAGE_IDS = new Set([
  'kassensystem',
  'so-funktionierts',
  'funktionen',
  'kartenzahlung',
  'funkbonieren',
  'verwaltung',
  'datenexport-steuerberater',
  'branchen',
  'restaurant',
  'cafe',
  'bar',
  'friseur',
  'friseure',
  'beauty',
  'sonstige',
]);

export async function getStaticPaths() {
  const pages = await getCollection('orderlyzePages');
  return pages
    .filter((page) => page.id !== 'home')
    .filter((page) => !DEDICATED_PAGE_IDS.has(page.id))
    .map((page) => ({
      params: { slug: slugParamFromPage(page) },
      props: { page },
    }));
}

const { page } = Astro.props;
const title = pageTitle(page);
const description = pageDescription(page);
const canonical = canonicalFromPage(page);
const keyword = pageKeyword(page);
const siteUrl = absoluteSiteUrl(Astro.site);
const sections = contentSections(page);

const heroHeading = title
  .replace(/\s+\|\s+Orderlyze$/, '')
  .replace(/^Orderlyze\s+[-|]\s+/i, '')
  .trim();
const heroHeadingLower = heroHeading.toLowerCase();

const LEGAL_IDS = new Set(['agb', 'impressum', 'datenschutzerklaerung']);
const BRANCHES_ID = 'branchen';
const PRICING_ID = 'preise';
const MINIMAL_IDS = new Set(['dank']);
const isLegal = LEGAL_IDS.has(page.id);
const isBranches = page.id === BRANCHES_ID;
const isPricing = page.id === PRICING_ID;
const isMinimal = MINIMAL_IDS.has(page.id);

const featureSections = sections
  .filter((s) => s.heading && s.heading.toLowerCase() !== heroHeadingLower)
  .filter((s) => s.paragraphs.length > 0)
  .filter((s) => s.heading.length >= 10 || s.heading.split(/\s+/).length >= 2)
  .slice(0, 6);

const bulletSections = sections
  .filter((s) => s.heading && s.paragraphs.length === 0)
  .map((s) => s.heading)
  .filter((heading) => heading.toLowerCase() !== heroHeadingLower)
  .filter((heading) => heading.length >= 8 && heading.length <= 60)
  .filter((heading) => heading.split(/\s+/).length >= 2)
  .slice(0, 9);

const featureImages = [
  '/images/orderlyze/checkout-counter.jpg',
  '/images/orderlyze/app-phone.png',
  '/images/orderlyze/card-payment.jpg',
  '/images/orderlyze/accounting.jpg',
  '/images/orderlyze/devices-small.jpg',
  '/images/orderlyze/support.jpg',
];

const heroImageMap: Record<string, string> = {
  kassensystem: '/images/orderlyze/checkout-counter.jpg',
  'so-funktionierts': '/images/orderlyze/home-hero-person.jpg',
  funktionen: '/images/orderlyze/checkout-counter.jpg',
  kartenzahlung: '/images/orderlyze/card-payment.jpg',
  funkbonieren: '/images/orderlyze/checkout-counter.jpg',
  verwaltung: '/images/orderlyze/accounting.jpg',
  'datenexport-steuerberater': '/images/orderlyze/accounting.jpg',
  branchen: '/images/orderlyze/home-hero-person.jpg',
  restaurant: '/images/orderlyze/branch-restaurant.jpg',
  cafe: '/images/orderlyze/branch-cafe.jpg',
  bar: '/images/orderlyze/branch-bar.jpg',
  friseur: '/images/orderlyze/branch-friseur.jpg',
  friseure: '/images/orderlyze/branch-friseur.jpg',
  beauty: '/images/orderlyze/branch-beauty.jpg',
  sonstige: '/images/orderlyze/branch-physio.jpg',
  preise: '/images/orderlyze/hero-system.png',
};

const pageImage = heroImageMap[page.id] ?? '/images/orderlyze/home-hero-person.jpg';

const testimonials = [
  {
    image: '/images/orderlyze/customer-carlo.jpg',
    name: 'Carlo M.',
    role: 'Pizzeria',
    copy: 'Seit dem wir Orderlyze verwenden, haben wir kaum noch Probleme gehabt. Alles geht super einfach und wir haben eine enorme Flexibilität.',
  },
  {
    image: '/images/orderlyze/customer-helene.jpg',
    name: 'Helene S.',
    role: 'Kosmetikerin',
    copy: 'Orderlyze hat mir den Alltag deutlich erleichtert. Ich gelange sehr viel schneller an wichtige Informationen.',
  },
];

const gastroBranches = [
  ['Restaurant', '/restaurant/', '/images/orderlyze/branch-restaurant.jpg'],
  ['Cafe', '/cafe/', '/images/orderlyze/branch-cafe.jpg'],
  ['Bar', '/bar/', '/images/orderlyze/branch-bar.jpg'],
];
const serviceBranches = [
  ['Friseur', '/friseur/', '/images/orderlyze/branch-friseur.jpg'],
  ['Beauty', '/beauty/', '/images/orderlyze/branch-beauty.jpg'],
  ['Sonstige', '/sonstige/', '/images/orderlyze/branch-physio.jpg'],
];

const pricingTiers = [
  {
    name: 'Dienstleistungen',
    price: '39€',
    period: 'pro Monat',
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
  {
    name: 'Gastronomie',
    price: '49€',
    period: 'pro Monat',
    featured: true,
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
  {
    name: 'Gastronomie +',
    price: '75€',
    period: 'pro Monat',
    bullets: [
      'alle Funktionen enthalten',
      'kostenloser Support',
      'mit Küchenkommunikation',
      'unbegrenzt viele Geräte',
      'Finanzamt Signatur inkl.',
      'keine zusätzlichen Kosten!',
    ],
  },
];

const legalBlocks = isLegal ? contentBlocks(page).filter((line) => line.toLowerCase() !== heroHeadingLower) : [];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={pageImage}
  jsonLd={pageSchema(page, siteUrl)}
>
  {
    isLegal ? (
      <>
        <section class="legal-banner">
          <div class="container">
            <h1>{heroHeading}</h1>
          </div>
        </section>
        <section class="legal-body">
          <div class="container">
            {legalBlocks.map((line) => <p>{line}</p>)}
          </div>
        </section>
      </>
    ) : (
      <section class="page-hero">
        <img
          class="page-hero-image"
          src={withBasePath(pageImage)}
          alt={`${heroHeading} - Orderlyze`}
          width="1920"
          height="900"
          loading="eager"
          decoding="async"
        />
        <div class="page-hero-overlay" aria-hidden="true"></div>
        <div class="page-hero-content">
          <h1>{heroHeading}</h1>
          <a class="button hero-cta" href={withBasePath('/angebot/')}>Jetzt loslegen</a>
        </div>
      </section>
    )
  }

  {
    isBranches && (
      <>
        <section class="section branches-section">
          <div class="container center">
            <h2>Gastronomie</h2>
            <div class="branches-grid">
              {gastroBranches.map(([label, href, image]) => (
                <a class="branch-card" href={withBasePath(href)}>
                  <img src={withBasePath(image)} alt={`${label} mit Orderlyze Kassensystem`} width="411" height="452" loading="eager" />
                  <span>{label}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="section branches-section soft">
          <div class="container center">
            <h2>Dienstleistungen</h2>
            <div class="branches-grid">
              {serviceBranches.map(([label, href, image]) => (
                <a class="branch-card" href={withBasePath(href)}>
                  <img src={withBasePath(image)} alt={`${label} mit Orderlyze Kassensystem`} width="411" height="452" loading="eager" />
                  <span>{label}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    isPricing && (
      <section class="section pricing-section">
        <div class="container center">
          <h2>Unsere Preise</h2>
          <p class="section-lead">Die Kosten für das Orderlyze Kassensystem bestehen aus monatlicher Software-Lizenz und einmaliger Hardware.</p>
          <div class="pricing-grid">
            {pricingTiers.map((tier) => (
              <article class:list={['pricing-card', { featured: tier.featured }]}>
                <h3>{tier.name}</h3>
                <ul>
                  {tier.bullets.map((b) => <li>{b}</li>)}
                </ul>
                <div class="pricing-total">
                  <span>GESAMT</span>
                  <strong>{tier.price}</strong>
                  <small>{tier.period}</small>
                </div>
                <a class="button primary" href={withBasePath('/angebot/')}>Kassensystem bestellen</a>
              </article>
            ))}
          </div>
          <p class="pricing-note">*Preise exkl. MwSt. Einmalige Aktivierungsgebühr € 199,-</p>
        </div>
      </section>
    )
  }

  {
    !isLegal && !isBranches && !isPricing && bulletSections.length >= 3 && (
      <section class="section bullets-section">
        <div class="container center">
          <h2>Auf einen Blick</h2>
          <div class="bullet-grid">
            {bulletSections.map((item) => (
              <div class="bullet-card">
                <span class="bullet-dot" aria-hidden="true"></span>
                {item}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isLegal && !isBranches && !isPricing && featureSections.length > 0 && (
      <section class="feature-stack">
        <div class="feature-stack-inner">
          <p class="section-eyebrow">{keyword}</p>
          <h2 class="section-title">{heroHeading}</h2>
          <div class="feature-cards">
            {featureSections.map((section, index) => (
              <article class:list={['feature-card', { 'has-media': index % 2 === 1 }]}>
                {index % 2 === 1 && (
                  <img
                    class="feature-card-image"
                    src={withBasePath(featureImages[index % featureImages.length])}
                    alt=""
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="feature-card-body">
                  <h3>{section.heading}</h3>
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isLegal && !isMinimal && (
      <section class="section testimonials-section">
        <div class="container">
          <h2 class="testimonials-title">Unzählige Kunden schenken uns ihr Vertrauen</h2>
          <div class="testimonial-grid">
            {testimonials.map((t, i) => (
              <article class:list={['testimonial-row', { reverse: i % 2 === 1 }]}>
                <img src={withBasePath(t.image)} alt={`${t.name} nutzt Orderlyze`} width="685" height="531" loading="eager" />
                <div class="testimonial-copy">
                  <span aria-hidden="true">”</span>
                  <h3>{t.name}</h3>
                  <strong>{t.role}</strong>
                  <p>{t.copy}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isLegal && (
      <section class="accent-cta">
        <h2>Interessiert? Dann hol dir ein unverbindliches Angebot!</h2>
        <a class="button accent-cta-btn" href={withBasePath('/angebot/')}>Angebot anfordern</a>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    min-height: clamp(360px, 52vh, 540px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #0b1220;
    text-align: center;
    color: white;
    isolation: isolate;
  }

  .page-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(11 18 32 / 35%) 0%, rgb(11 18 32 / 60%) 100%);
    z-index: -1;
  }

  .page-hero-content {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding: clamp(56px, 9vw, 96px) 24px;
    max-width: 960px;
  }

  h1 {
    margin: 0;
    color: white;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1.05;
    text-shadow: 0 4px 24px rgb(0 0 0 / 35%);
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .hero-cta {
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    padding: 0 32px;
    height: 52px;
    line-height: 52px;
    border-radius: 999px;
    font-size: 0.95rem;
  }

  .hero-cta:hover {
    background: #044d8c;
    color: white;
  }

  .legal-banner {
    padding: 56px 0;
    background: var(--accent);
    color: white;
    text-align: center;
  }

  .legal-banner h1 {
    color: white;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .legal-body {
    padding: 56px 0;
    background: white;
  }

  .legal-body .container {
    max-width: 920px;
  }

  .legal-body p {
    margin: 0 0 12px;
    color: #1f2937;
    font-size: 0.96rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .bullets-section,
  .branches-section {
    background: white;
  }

  .branches-section.soft {
    background: var(--soft);
  }

  .center h2 {
    margin: 0 0 36px;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.05;
    text-align: center;
  }

  .section-lead {
    margin: -20px auto 32px;
    max-width: 720px;
    text-align: center;
    color: var(--muted);
  }

  .bullet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    text-align: left;
  }

  .bullet-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--soft);
    color: var(--ink);
    font-weight: 700;
  }

  .bullet-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 999px;
    background: var(--accent);
  }

  .branches-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .branch-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 12px;
    color: var(--ink);
  }

  .branch-card img {
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  .branch-card span {
    position: absolute;
    left: 0;
    bottom: 0;
    min-width: 64%;
    padding: 14px 18px;
    background: white;
    font-weight: 900;
  }

  .pricing-section {
    background: white;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 32px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
    box-shadow: 0 16px 36px rgb(15 23 42 / 6%);
  }

  .pricing-card.featured {
    border-color: var(--accent);
    box-shadow: 0 20px 44px rgb(6 89 169 / 16%);
    transform: translateY(-8px);
  }

  .pricing-card h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .pricing-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .pricing-card li {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }

  .pricing-card li:last-child {
    border-bottom: 0;
  }

  .pricing-total {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .pricing-total span {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing-total strong {
    font-size: 2.4rem;
    color: var(--accent);
    font-weight: 900;
    line-height: 1;
  }

  .pricing-total small {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .pricing-note {
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .feature-stack {
    padding: clamp(56px, 8vw, 96px) max(24px, calc((100vw - 1180px) / 2));
    background: #f7f8fb;
  }

  .feature-stack-inner {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .section-eyebrow {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0 0 48px;
    color: var(--ink);
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1.1;
  }

  .feature-cards {
    display: grid;
    gap: 28px;
    text-align: left;
  }

  .feature-card {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    background: white;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgb(15 23 42 / 8%);
  }

  .feature-card.has-media {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .feature-card.has-media:nth-of-type(odd) {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .feature-card-image {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
    display: block;
  }

  .feature-card-body {
    padding: clamp(28px, 4vw, 48px);
    align-self: center;
  }

  .feature-card-body h3 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.2;
  }

  .feature-card-body p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .feature-card-body p:last-child {
    margin-bottom: 0;
  }

  .testimonials-section {
    padding: clamp(56px, 8vw, 96px) 0;
    background: white;
  }

  .testimonials-title {
    margin: 0 0 36px;
    text-align: center;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
  }

  .testimonial-grid {
    display: grid;
    gap: 24px;
  }

  .testimonial-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: stretch;
  }

  .testimonial-row.reverse {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .testimonial-row.reverse img {
    order: 2;
  }

  .testimonial-row img {
    width: 100%;
    min-height: 380px;
    object-fit: cover;
    border-radius: 12px;
  }

  .testimonial-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 4vw, 60px);
    background: var(--soft);
    border-radius: 12px;
  }

  .testimonial-copy span {
    position: absolute;
    top: 18px;
    right: 28px;
    color: var(--ink);
    font-size: 4rem;
    line-height: 1;
    font-weight: 900;
  }

  .testimonial-copy h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .testimonial-copy strong {
    margin: 6px 0 16px;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .testimonial-copy p {
    margin: 0;
    color: var(--muted);
  }

  .accent-cta {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding: clamp(56px, 8vw, 88px) 20px;
    background: var(--accent);
    color: white;
    text-align: center;
  }

  .accent-cta h2 {
    margin: 0;
    max-width: 760px;
    color: white;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.2;
  }

  .accent-cta-btn {
    background: white;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }

  .accent-cta-btn:hover {
    background: #e5edf7;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-inner,
    .feature-row,
    .branches-grid,
    .pricing-grid,
    .testimonial-row,
    .testimonial-row.reverse {
      grid-template-columns: 1fr;
    }

    .feature-row.reverse .feature-copy,
    .testimonial-row.reverse img {
      order: 0;
    }

    .pricing-card.featured {
      transform: none;
    }
  }
</style>
