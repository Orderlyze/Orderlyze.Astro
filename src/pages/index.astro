---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  contentBlocks,
  pageDescription,
  pageSchema,
  pageTitle,
} from '../lib/orderlyze-pages';
import { absoluteSiteUrl, withBasePath } from '../lib/url';

const pages = await getCollection('orderlyzePages');
const home = pages.find((page) => page.id === 'home');

if (!home) {
  throw new Error('Missing scraped Orderlyze home page.');
}

const title = pageTitle(home);
const description = pageDescription(home);
const siteUrl = absoluteSiteUrl(Astro.site);
const blocks = contentBlocks(home);
const highlights = [
  {
    title: 'Einfach kassieren',
    copy: 'Rechnungen in Sekundenschnelle erstellen, Produkte bearbeiten und Bestellungen unkompliziert stornieren.',
    href: '/kassensystem/',
  },
  {
    title: '100% finanzamtkonform',
    copy: 'Orderlyze bleibt konform und exportiert wichtige Berichte fuer den Steuerberater mit wenigen Klicks.',
    href: '/finanzamt-konform/',
  },
  {
    title: 'Kartenzahlung bereit',
    copy: 'EC, Maestro/V Pay, MasterCard, Visa, Apple Pay und kontaktlose Zahlungen per NFC sind Teil des Systems.',
    href: '/kartenzahlung/',
  },
];

const industries = [
  ['Gastronomie', '/gastronomie/'],
  ['Restaurant', '/restaurant/'],
  ['Cafe', '/cafe/'],
  ['Bar', '/bar/'],
  ['Friseur', '/friseur/'],
  ['Beauty', '/beauty/'],
  ['Sonstige Branchen', '/sonstige/'],
];

const featureLinks = [
  ['Funktionen', '/funktionen/'],
  ['Funkbonieren', '/funkbonieren/'],
  ['Verwaltung', '/verwaltung/'],
  ['Datenexport fuer Steuerberater', '/datenexport-steuerberater/'],
  ['Technische Sicherheitseinrichtung', '/technische-sicherheitseinrichtung/'],
  ['Bestellsystem', '/bestellsystem/'],
];

const jsonLd = [
  ...pageSchema(home, siteUrl),
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Orderlyze',
    url: siteUrl,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '0800 400 4511',
      contactType: 'sales',
      areaServed: 'DE',
      availableLanguage: 'de',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Orderlyze Kassensystem',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, iOS, Android',
    description,
  },
];
---

<BaseLayout title={title} description={description} canonical="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Orderlyze Kassensystem</p>
        <h1>Registrierkasse einfach. schnell. effizient.</h1>
        <p class="hero-lede">
          Einfach zu bedienen, schnell eingerichtet und so effizient, dass du viel mehr
          Zeit fuer deine KundInnen hast. 100% finanzamtkonform.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={withBasePath('/angebot/')}>Kostenloses Angebot</a>
          <a class="button secondary" href={withBasePath('/so-funktionierts/')}>So funktioniert's</a>
        </div>
      </div>
      <figure class="hero-visual">
        <img
          src={withBasePath('/images/orderlyze/hero-system.png')}
          alt="Orderlyze Kassensystem auf Tablet, Smartphone und Bondrucker"
          width="1096"
          height="914"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section trust-band">
    <div class="container trust-grid">
      <div>
        <strong>100%</strong>
        <span>finanzamtkonform</span>
      </div>
      <div>
        <strong>0800</strong>
        <span>kostenlose Hotline</span>
      </div>
      <div>
        <strong>NFC</strong>
        <span>kontaktlos bezahlen</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Bei uns bist du einfach richtig</p>
      <h2 class="section-title">Wirklich einfach. Wirklich zuverlaessig. Mit allem, was du brauchst.</h2>
      <div class="feature-grid">
        {
          highlights.map((item) => (
            <article class="card feature-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <a href={withBasePath(item.href)}>Mehr erfahren</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container split">
      <div>
        <p class="eyebrow">Branchen</p>
        <h2 class="section-title">Perfekt fuer Gastronomie und Dienstleistungen.</h2>
        <p class="section-copy">
          Orderlyze passt zu Restaurants, Cafes, Bars, Friseuren, Beauty-Angeboten und
          weiteren Branchen, die ein schnelles und flexibles Kassensystem brauchen.
        </p>
      </div>
      <div class="link-grid">
        {
          industries.map(([label, href]) => (
            <a class="card link-card" href={withBasePath(href)}>{label}</a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Funktionen</p>
        <h2 class="section-title">Alles vorbereitet fuer deinen Alltag.</h2>
        <p class="section-copy">
          Von Verwaltung ueber Funkbonieren bis zum Datenexport fuer Steuerberater:
          Die wichtigsten Funktionen sind als eigene SEO-Seiten verfuegbar.
        </p>
      </div>
      <div class="link-grid">
        {
          featureLinks.map(([label, href]) => (
            <a class="card link-card" href={withBasePath(href)}>{label}</a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section source-section">
    <div class="container">
      <p class="eyebrow">Originalinhalt</p>
      <h2 class="section-title">Inhalte aus orderlyze.com als Astro-Seite.</h2>
      <div class="source-copy">
        {
          blocks.slice(0, 24).map((line) => (
            line.length < 64 ? <h3>{line}</h3> : <p>{line}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section image-band">
    <div class="container image-grid">
      <img src={withBasePath('/images/orderlyze/konform-1.png')} alt="Orderlyze Illustration zur Kassensystem-Konformitaet" width="300" height="220" loading="eager" />
      <img src={withBasePath('/images/orderlyze/konform-2.png')} alt="Orderlyze Illustration zur Finanzamt-Konformitaet" width="300" height="220" loading="eager" />
      <img src={withBasePath('/images/orderlyze/funktionen-illustration.png')} alt="Orderlyze Illustration der Kassensystem-Funktionen" width="300" height="220" loading="eager" />
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta">
      <p class="eyebrow">Kostenlos und unverbindlich</p>
      <h2>Hol dir jetzt ein kostenloses Angebot.</h2>
      <a class="button primary" href={withBasePath('/angebot/')}>Angebot anfordern</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: grid;
    align-items: center;
    padding: 70px 0;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 72% 34%, var(--blue-soft), transparent 34%),
      #ffffff;
  }

  .hero-grid,
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.78fr);
    gap: 44px;
    align-items: center;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
    font-size: clamp(3rem, 7vw, 6.7rem);
    line-height: 0.92;
    letter-spacing: 0;
  }

  .hero-lede {
    max-width: 680px;
    margin: 28px 0 0;
    color: #374151;
    font-size: clamp(1.14rem, 2vw, 1.42rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero-visual {
    margin: 0;
  }

  .hero-visual img {
    width: min(100%, 620px);
    margin-inline: auto;
    filter: drop-shadow(0 28px 50px rgb(6 89 169 / 22%));
  }

  .trust-band {
    padding: 28px 0;
    background: var(--accent);
    color: white;
  }

  .trust-grid,
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .trust-grid div {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .trust-grid strong {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
  }

  .trust-grid span {
    color: #d1d5db;
    font-weight: 800;
  }

  .feature-grid {
    margin-top: 34px;
  }

  .feature-card {
    padding: 24px;
  }

  .feature-card h3 {
    margin: 0 0 12px;
  }

  .feature-card p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .feature-card a,
  .link-card {
    color: var(--accent);
    font-weight: 900;
  }

  .soft-section,
  .source-section {
    background: var(--soft);
  }

  .image-band {
    background: #ffffff;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: center;
  }

  .image-grid img {
    width: 100%;
    border-radius: 8px;
    background: var(--soft);
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .link-card {
    display: flex;
    min-height: 68px;
    align-items: center;
    padding: 18px;
  }

  .source-copy {
    display: grid;
    gap: 14px;
    max-width: 820px;
    margin-top: 34px;
  }

  .source-copy h3,
  .source-copy p {
    margin: 0;
  }

  .source-copy p {
    color: #374151;
  }

  .cta-section {
    background: var(--accent);
    color: white;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    line-height: 1.02;
  }

  .cta .eyebrow {
    color: #67e8f9;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split,
    .feature-grid,
    .trust-grid,
    .image-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    .link-grid {
      grid-template-columns: 1fr;
    }

    .cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
