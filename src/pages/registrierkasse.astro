---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoLanding from '../components/orderlyze/SeoLanding.astro';
import { absoluteSiteUrl } from '../lib/url';

const title = 'Registrierkasse | Orderlyze';
const description = 'Die Nr 1. Registrierkasse für jeden Bedarf. RKSV, KassenSichV und TSE konform. Einfach, schnell, effizient.';
const canonical = '/registrierkasse/';
const siteUrl = absoluteSiteUrl(Astro.site);
---

<BaseLayout title={title} description={description} canonical={canonical} image="/images/orderlyze/checkout-counter.jpg"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: new URL(canonical, siteUrl).toString(), inLanguage: 'de-DE' }}>
  <SeoLanding
    term="Registrierkasse"
    termArticle="die"
    heroTitle={'Die Nr 1. Registrierkasse für jeden Bedarf'}
    introHeading="Wir haben genau das Richtige für dich"
    ctaTitle="Hol dir ein individuelles Angebot für die Registrierkasse"
  />
</BaseLayout>
