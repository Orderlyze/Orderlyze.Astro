---
import Seo from '../components/Seo.astro';
import { withBasePath } from '../lib/url';
import { NAVIGATION, SITE } from '../site.config';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const { title, description, canonical, image, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={withBasePath('/')} aria-label={`${SITE.name} home`}>
          <img src={withBasePath('/images/orderlyze/logo.png')} alt="Orderlyze" width="205" height="52" />
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <ul>
            {
              NAVIGATION.map((item) => (
                <li class:list={['nav-item', { 'has-children': !!item.children?.length }]}>
                  <a href={withBasePath(item.href)} class="nav-link">
                    <span>{item.label}</span>
                    {item.children && item.children.length > 0 && (
                      <svg class="nav-caret" viewBox="0 0 12 8" width="10" height="6" aria-hidden="true">
                        <path fill="currentColor" d="M6 8 0 0h12z" />
                      </svg>
                    )}
                  </a>
                  {item.children && item.children.length > 0 && (
                    <div class="submenu" role="menu">
                      <ul>
                        {item.children.map((child) => (
                          <li>
                            <a href={withBasePath(child.href)} role="menuitem">{child.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-actions">
          <div class="header-actions-row top">
            <a class="header-phone" href="tel:08004004511" aria-label="Telefon 0800 400 4511">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
                <path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" />
              </svg>
              <strong>0800 400 4511</strong>
            </a>
            <a class="button header-cta" href={withBasePath('/angebot/')}>Kostenloses Angebot</a>
          </div>
          <div class="header-actions-row bottom">
            <a class="header-shop" href={withBasePath('/thermorollen/')} aria-label="Shop Thermorollen">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.5 11.5a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6" />
                <circle cx="10" cy="20" r="1.4" fill="currentColor" />
                <circle cx="17" cy="20" r="1.4" fill="currentColor" />
              </svg>
              <strong>SHOP</strong>
            </a>
          </div>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src={withBasePath('/images/orderlyze/logo.png')} alt="Orderlyze" width="180" height="46" />
          <p>Orderlyze Kassensystem. Einfach zu bedienen, schnell eingerichtet und 100% finanzamtkonform.</p>
          <a class="footer-phone" href="tel:08004004511">0800 400 4511</a>
        </div>
        <div class="footer-col">
          <h4>Kassensystem</h4>
          <a href={withBasePath('/kassensystem/')}>Kassensystem</a>
          <a href={withBasePath('/funktionen/')}>Funktionen</a>
          <a href={withBasePath('/kartenzahlung/')}>Kartenzahlung</a>
          <a href={withBasePath('/preise/')}>Preise</a>
          <a href={withBasePath('/hardware/')}>Hardware</a>
        </div>
        <div class="footer-col">
          <h4>Branchen</h4>
          <a href={withBasePath('/restaurant/')}>Restaurant</a>
          <a href={withBasePath('/cafe/')}>Cafe</a>
          <a href={withBasePath('/bar/')}>Bar</a>
          <a href={withBasePath('/friseur/')}>Friseur</a>
          <a href={withBasePath('/beauty/')}>Beauty</a>
        </div>
        <div class="footer-col">
          <h4>Unternehmen</h4>
          <a href={withBasePath('/angebot/')}>Kostenloses Angebot</a>
          <a href={withBasePath('/so-funktionierts/')}>So funktioniert's</a>
          <a href={withBasePath('/impressum/')}>Impressum</a>
          <a href={withBasePath('/datenschutzerklaerung/')}>Datenschutz</a>
          <a href={withBasePath('/agb/')}>AGB</a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <span>© {new Date().getFullYear()} {SITE.name}. Alle Rechte vorbehalten.</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(217 222 231 / 78%);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 96px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand img {
    width: 168px;
    height: auto;
  }

  .primary-nav {
    margin-inline: auto;
  }

  .primary-nav > ul {
    display: flex;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav .nav-item {
    position: relative;
  }

  .primary-nav .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 36px 2px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  .primary-nav .nav-link:hover,
  .primary-nav .nav-item:hover > .nav-link,
  .primary-nav .nav-item:focus-within > .nav-link {
    color: var(--accent);
  }

  .nav-caret {
    margin-top: 2px;
    transition: transform 160ms ease;
  }

  .primary-nav .nav-item:hover .nav-caret,
  .primary-nav .nav-item:focus-within .nav-caret {
    transform: rotate(180deg);
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 30;
    min-width: 240px;
    transform: translate(-50%, 8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms ease, transform 140ms ease;
    background: white;
    border: 1px solid rgb(15 23 42 / 8%);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(15 23 42 / 14%);
    padding: 8px 0;
  }

  .primary-nav .nav-item:hover > .submenu,
  .primary-nav .nav-item:focus-within > .submenu {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .submenu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .submenu a {
    display: block;
    padding: 10px 22px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .submenu a:hover {
    background: var(--soft);
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }

  .header-actions-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .header-actions-row.bottom {
    justify-content: flex-end;
    width: 100%;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    line-height: 1;
  }

  .header-phone svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .header-phone strong {
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--ink);
  }

  .header-phone:hover strong {
    color: var(--accent);
  }

  .header-cta {
    background: var(--accent);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.82rem;
    font-weight: 800;
    white-space: nowrap;
    border: 0;
  }

  .header-cta:hover {
    background: #044d8c;
    color: white;
  }

  .header-shop {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    line-height: 1;
  }

  .header-shop svg {
    color: #0f172a;
    flex-shrink: 0;
  }

  .header-shop strong {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .header-shop:hover strong,
  .header-shop:hover svg {
    color: var(--accent);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: #0b1220;
    color: #d1d5db;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 36px;
    padding: 64px 0 32px;
  }

  .footer-brand img {
    width: 168px;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .footer-brand p {
    margin: 18px 0;
    color: #9ca3af;
    font-size: 0.95rem;
    max-width: 320px;
  }

  .footer-phone {
    display: inline-block;
    color: white;
    font-size: 1.25rem;
    font-weight: 900;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col h4 {
    margin: 0 0 6px;
    color: white;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-col a {
    color: #d1d5db;
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: white;
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 8%);
    padding: 20px 0;
    color: #9ca3af;
    font-size: 0.85rem;
  }

  @media (max-width: 1180px) {
    .primary-nav > ul {
      gap: 22px;
    }

    .header-actions-row.bottom {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .primary-nav {
      display: none;
    }

    .header-phone strong {
      display: none;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 560px) {
    .header-cta {
      padding: 0 14px;
      font-size: 0.88rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
