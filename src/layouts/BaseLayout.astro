---
import Seo from '../components/Seo.astro';
import { NAVIGATION, SITE } from '../site.config';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const { title, description, canonical, image, jsonLd } = Astro.props;
const withBase = (href: string) => {
  if (href.startsWith('#') || href.startsWith('http') || href.startsWith('tel:') || href.startsWith('mailto:')) {
    return href;
  }
  return `${import.meta.env.BASE_URL}${href.replace(/^\/+/, '')}`;
};
---

<!doctype html>
<html lang="de">
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label={`${SITE.name} home`}>
          <span class="brand-mark" aria-hidden="true">O</span>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Primary navigation">
          {
            NAVIGATION.map((item) => (
              <a href={withBase(item.href)}>{item.label}</a>
            ))
          }
        </nav>
        <a class="button secondary header-cta" href={withBase('/angebot/')}>Angebot</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{SITE.name} Kassensystem. Einfach zu bedienen, schnell eingerichtet und finanzamtkonform.</p>
        <div class="footer-links">
          <a href={withBase('/impressum/')}>Impressum</a>
          <a href={withBase('/datenschutzerklaerung/')}>Datenschutz</a>
          <a href={withBase('/agb/')}>AGB</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(217 222 231 / 78%);
    background: rgb(251 252 254 / 88%);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 8px;
    background: #111827;
    color: white;
    font-size: 0.92rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #374151;
    font-size: 0.94rem;
    font-weight: 750;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: white;
  }

  .footer-inner {
    display: flex;
    min-height: 96px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
  }

  .footer-inner a {
    font-weight: 800;
    color: var(--ink);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 840px) {
    nav {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-cta {
      display: none;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
